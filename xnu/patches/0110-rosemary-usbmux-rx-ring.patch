+	gpd->dw0_info = (ru.rx_gen2 ? (RU_RX_CAPACITY << 12) : (RU_RX_CAPACITY << 16)) |
+	    RU_QMU_GPD_IOC;
+	ru_dma_sync(buffer_off, RU_RX_CAPACITY);
+	ru_dma_clean(RU_GPD_RX_OFF + slot * sizeof(*gpd), sizeof(*gpd));
+	__asm__ volatile("dsb sy" ::: "memory");
+	gpd->dw0_info |= RU_QMU_GPD_HWO;
+	ru_dma_clean(RU_GPD_RX_OFF + slot * sizeof(*gpd), sizeof(*gpd));
+	__asm__ volatile("dsb sy" ::: "memory");

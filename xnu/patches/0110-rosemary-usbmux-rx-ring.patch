+	struct ru_qmu_gpd *gpd = ru_rx_gpd() + slot;
+	uint32_t next_slot = (slot + 1u) % RU_RX_RING_DEPTH;
+	uint64_t gpd_pa = ru.dma_pa + RU_GPD_RX_OFF + (uint64_t)slot * sizeof(*gpd);
+	uint64_t next_pa = ru.dma_pa + RU_GPD_RX_OFF + (uint64_t)next_slot * sizeof(*gpd);
+	uint32_t buffer_off = RU_RX_BUFFER_OFF + slot * RU_RX_CAPACITY;
+	uint64_t buffer_pa = ru.dma_pa + buffer_off;

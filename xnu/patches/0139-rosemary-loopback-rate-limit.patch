-	uint32_t chunks = 0u;
+	uint64_t now, hz;
+	struct msghdr msg;
+	struct iovec iov;
+	size_t recvd = 0;
+	errno_t err;
 
 	lck_mtx_lock(ru.tx_lock);
 	if (!ru.loop[i].valid || ru.loop[i].so == NULL) {
 		lck_mtx_unlock(ru.tx_lock);
 		return;
 	}
+	now = ru_counter();
+	if (now < ru.loop[i].next_send_tick) {
+		lck_mtx_unlock(ru.tx_lock);

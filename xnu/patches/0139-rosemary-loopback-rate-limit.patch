+	ru_loop_tx_segment(local_port, peer_port, our_seq, peer_seq, TH_ACK, buf, (uint32_t)recvd);
+	our_seq += (uint32_t)recvd;
+	hz = ru_counter_freq();
+	lck_mtx_lock(ru.tx_lock);
+	if (!ru.loop[i].valid || ru.loop[i].local_port != local_port ||
+	    ru.loop[i].peer_port != peer_port) {
+		lck_mtx_unlock(ru.tx_lock);
+		return; /* slot reused/closed concurrently (reset path) */
+	}
+	ru.loop[i].our_seq = our_seq;
+	if (hz != 0u) {

+		if (ru.loop[i].valid && ru.loop[i].local_port == local_port &&
+		    ru.loop[i].peer_port == peer_port) {
+			our_seq = ru.loop[i].our_seq;
+			peer_seq = ru.loop[i].peer_seq;
+			ru.loop[i].our_seq = our_seq + 1u; /* FIN consumes one seq */
+			ru_loop_close_locked((int)i);
 		}
-		ru.loop[i].our_seq = our_seq;

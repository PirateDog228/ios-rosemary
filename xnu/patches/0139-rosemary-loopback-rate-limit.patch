-				ru_loop_close_locked((int)i);
-			}
-			lck_mtx_unlock(ru.tx_lock);
-			ru_loop_tx_segment(local_port, peer_port, our_seq, peer_seq, TH_FIN | TH_ACK, NULL, 0u);
-			printf("ROSEMARY USB: loopback TCP %u->%u closed (err=%d); sent FIN\n",
-			    peer_port, local_port, err);
-			return;
-		}
+	if (err == EWOULDBLOCK || err == EAGAIN) return;
 
-		ru_loop_tx_segment(local_port, peer_port, our_seq, peer_seq, TH_ACK, buf, (uint32_t)recvd);
-		our_seq += (uint32_t)recvd;
+	if (err != 0 || recvd == 0u) {
 		lck_mtx_lock(ru.tx_lock);
-		if (!ru.loop[i].valid || ru.loop[i].local_port != local_port ||

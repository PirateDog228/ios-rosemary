- * service sent back to usbmuxd, translating EOF into a FIN. Bounded to a
- * few chunks per call (0138) so one fast connection cannot both starve the
- * other loopback slots and outrun usbmuxd's own buffer in a single burst. */
+ * service sent back to usbmuxd, translating EOF into a FIN. Paced by
+ * next_send_tick (0139) so a fast local producer (e.g. syslogd) cannot
+ * outrun usbmuxd's own small per-connection buffer. */
 static void ru_loop_poll_slot(uint32_t i)
 {
 	uint8_t buf[RU_LOOP_RX_CHUNK];
 	socket_t so;
 	uint16_t local_port, peer_port;

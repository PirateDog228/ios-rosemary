 	    rg_rd(gpu, 0x100), rg_rd(gpu, 0x110), rg_rd(gpu, 0x120));
 }

+/*
+ * The smallest job: a write-value header and its payload (target address,
+ * type = 32-bit immediate, value 0xc0ffee01). Target is at page_pa + 0x800.
+ * Caches flushed before and after, since GPU does not snoop CPU caches.
+ *
+ * Based on redwood_mali.c run_write_job() from HakiOS.
+ */
+static int
+rg_run_write_job(vm_offset_t gpu, vm_offset_t page_va, uint64_t page_pa)
+{
+	volatile uint32_t *job = (volatile uint32_t *)page_va;
+	volatile uint32_t *target = (volatile uint32_t *)(page_va + 0x800);
+	int ok;
+
+	bzero((void *)page_va, 4096);
+	job[4] = (2u << 1) | 1u | (1u << 16);   /* write value; 64-bit pointers; job index 1 */
+	job[8] = (uint32_t)(page_pa + 0x800);
+	job[9] = (uint32_t)((page_pa + 0x800) >> 32);
+	job[10] = 6;                            /* type: 32-bit immediate */
+	job[12] = 0xc0ffee01u;
+	FlushPoC_DcacheRegion(page_va, 4096);
+
+	/* Set up address space 0 in identity mode (AS_TRANSCFG mode 2: GPU addr = phys) */
+	rg_wr(gpu, AS0 + AS_TRANSTAB_LO, 0);
+	rg_wr(gpu, AS0 + AS_TRANSTAB_HI, 0);
+	rg_wr(gpu, AS0 + 0x30, 2);              /* AS_TRANSCFG_LO: identity */
+	rg_wr(gpu, AS0 + 0x34, 0);              /* AS_TRANSCFG_HI */
+	rg_wr(gpu, AS0 + AS_MEMATTR_LO, 0x88888888u);
+	rg_wr(gpu, AS0 + AS_MEMATTR_HI, 0x88888888u);
+	rg_wr(gpu, AS0 + AS_COMMAND, 1);        /* update */
+	if (!rg_wait(gpu, AS0 + AS_STATUS, 1, 0)) {
+		printf("ROSEMARY GPU: AS0 update timeout\n");
+		return 0;
+	}
+
+	/* Submit job to slot 1 */
+	rg_wr(gpu, JOB_INT_MASK, 0);
+	rg_wr(gpu, JOB_INT_CLEAR, 0xffffffffu);
+	rg_wr(gpu, JS1 + JS_HEAD_NEXT_LO, (uint32_t)page_pa);
+	rg_wr(gpu, JS1 + JS_HEAD_NEXT_HI, (uint32_t)(page_pa >> 32));
+	rg_wr(gpu, JS1 + JS_AFFINITY_NEXT_LO, shader_mask);
+	rg_wr(gpu, JS1 + JS_AFFINITY_NEXT_HI, 0);
+	rg_wr(gpu, JS1 + JS_CONFIG_NEXT, JS_CONFIG);
+	rg_wr(gpu, JS1 + JS_COMMAND_NEXT, 1);   /* start */
+
+	/* Wait for completion: bit 1 = slot 1 done, bit 17 = slot 1 failed */
+	if (!rg_wait(gpu, JOB_INT_RAWSTAT, (1u << 1) | (1u << 17), 1u << 1)) {
+		printf("ROSEMARY GPU: job timeout or failed, interrupts %08x\n", rg_rd(gpu, JOB_INT_RAWSTAT));
+	}
+
+	FlushPoC_DcacheRegion(page_va, 4096);
+	ok = (*target == 0xc0ffee01u);
+	printf("ROSEMARY GPU: job: irq=%08x slot_status=%08x mmu_fault=%08x job_status=%08x target=%08x%s\n",
+	    rg_rd(gpu, JOB_INT_RAWSTAT), rg_rd(gpu, JS1 + JS_STATUS), rg_rd(gpu, AS0 + AS_FAULTSTATUS),
+	    job[0], *target, ok ? " -- GPU wrote it" : " -- NOT WRITTEN");
+	rg_wr(gpu, JOB_INT_CLEAR, 0xffffffffu);
+	return ok;
+}
+
 void
 rosemary_gpu_probe(void)
 {
 	int mode = 1;
 	vm_offset_t spm, infra, topck, mfgcfg, gpu;
+	uint32_t shaders, tiler, l2, gpu_id;

 	if (PE_parse_boot_argn("rosemarygpu", &mode, sizeof(mode)) && mode == 0) {
 		return;
@@ -287,5 +487,52 @@ rosemary_gpu_probe(void)
 	rg_wr(mfgcfg, RG_MFG_CG_CLR, RG_MFG_CG_BG3D);
 	printf("ROSEMARY GPU: MFG_CG_CON after ungate=%08x\n", rg_rd(mfgcfg, RG_MFG_CG_CON));
 	rg_read_gpu(gpu);
+
+	/* Mode 3: soft reset, power cores, run identity-mode job */
+	if (mode >= 3) {
+		vm_offset_t page_va = 0;
+
+		if (kmem_alloc(kernel_map, &page_va, 4096, KMA_KOBJECT | KMA_ZERO | KMA_DATA, 0) != KERN_SUCCESS) {
+			printf("ROSEMARY GPU: no page for job\n");
+			return;
+		}
+		gpu_id = rg_rd(gpu, GPU_ID);
+		shader_mask = rg_rd(gpu, SHADER_PRESENT);
+		shaders = shader_mask;
+		tiler = rg_rd(gpu, TILER_PRESENT);
+		l2 = rg_rd(gpu, L2_PRESENT);
+
+		/* Soft reset */
+		rg_wr(gpu, GPU_INT_MASK, 0);
+		rg_wr(gpu, GPU_INT_CLEAR, 0xffffffffu);
+		rg_wr(gpu, GPU_CMD, 1);
+		if (!rg_wait(gpu, GPU_INT_RAWSTAT, IRQ_RESET_COMPLETED, IRQ_RESET_COMPLETED)) {
+			printf("ROSEMARY GPU: GPU_ID %08x reset timeout\n", gpu_id);
+			kmem_free(kernel_map, page_va, 4096);
+			return;
+		}
+		rg_wr(gpu, GPU_INT_CLEAR, 0xffffffffu);
+
+		/* Power on L2, tiler, shader cores */
+		rg_wr(gpu, L2_PWRON, l2);
+		rg_wr(gpu, TILER_PWRON, tiler);
+		rg_wr(gpu, SHADER_PWRON, shaders);
+		if (!rg_wait(gpu, L2_READY, l2, l2) || !rg_wait(gpu, TILER_READY, tiler, tiler) ||
+		    !rg_wait(gpu, SHADER_READY, shaders, shaders)) {
+			printf("ROSEMARY GPU: GPU_ID %08x cores power-on timeout, SHADER_READY=%08x\n",
+			    gpu_id, rg_rd(gpu, SHADER_READY));
+			kmem_free(kernel_map, page_va, 4096);
+			return;
+		}
+		printf("ROSEMARY GPU: Mali-G76 r%up%u all cores ready\n",
+		    (gpu_id >> 12) & 0xf, (gpu_id >> 4) & 0xff);
+
+		/* Run the job */
+		if (rg_run_write_job(gpu, page_va, kvtophys(page_va))) {
+			printf("ROSEMARY GPU: identity-mode job succeeded -- GPU job submission works\n");
+		} else {
+			printf("ROSEMARY GPU: identity-mode job FAILED\n");
+		}
+		kmem_free(kernel_map, page_va, 4096);
+	}
 }
 #endif /* ROSEMARY */

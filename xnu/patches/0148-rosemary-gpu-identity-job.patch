 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern uint64_t kvtophys(vm_offset_t va);
+extern void FlushPoC_DcacheRegion(vm_offset_t va, size_t length);
 void rosemary_gpu_probe(void);

 #define RG_SPM_PA            0x10006000u
@@ -77,6 +104,43 @@ void rosemary_gpu_probe(void);
 #define RG_MFG_CG_CLR        0x08u
 #define RG_MFG_CG_BG3D       0x1u

+#define GPU_ID               0x000u
+#define GPU_INT_RAWSTAT      0x020u
+#define GPU_INT_CLEAR        0x024u
+#define GPU_INT_MASK         0x028u
+#define GPU_CMD              0x030u
+#define SHADER_PRESENT       0x100u
+#define TILER_PRESENT        0x110u
+#define L2_PRESENT           0x120u
+#define SHADER_READY         0x140u
+#define TILER_READY          0x150u
+#define L2_READY             0x160u
+#define SHADER_PWRON         0x180u
+#define TILER_PWRON          0x190u
+#define L2_PWRON             0x1a0u
+#define IRQ_RESET_COMPLETED  (1u<<8)
+#define JOB_INT_RAWSTAT      0x1000u
+#define JOB_INT_CLEAR        0x1004u
+#define JOB_INT_MASK         0x1008u
+#define JS1                  0x1880u
+#define JS_STATUS            0x24u
+#define JS_HEAD_NEXT_LO      0x40u
+#define JS_HEAD_NEXT_HI      0x44u
+#define JS_AFFINITY_NEXT_LO  0x50u
+#define JS_AFFINITY_NEXT_HI  0x54u
+#define JS_CONFIG_NEXT       0x58u
+#define JS_COMMAND_NEXT      0x60u
+#define JS_CONFIG            ((3u<<8)|(3u<<12)|(8u<<16))
+#define AS0                  0x2400u
+#define AS_TRANSTAB_LO       0x00u
+#define AS_TRANSTAB_HI       0x04u
+#define AS_MEMATTR_LO        0x08u
+#define AS_MEMATTR_HI        0x0cu
+#define AS_COMMAND           0x18u
+#define AS_FAULTSTATUS       0x1cu
+#define AS_STATUS            0x28u
+
+static uint32_t shader_mask;
+
 struct rg_domain {
 	const char *name;
 	uint32_t con;       /* PWR_CON offset in SPM */
@@ -217,9 +281,81 @@ rg_read_gpu(vm_offset_t gpu)
 	    rg_rd(gpu, 0x100), rg_rd(gpu, 0x110), rg_rd(gpu, 0x120));
 }

+static int
+rg_run_write_job(vm_offset_t gpu, vm_offset_t page_va, uint64_t page_pa)
+{
+	volatile uint32_t *job = (volatile uint32_t *)page_va, *target = (volatile uint32_t *)(page_va+0x800);
+	int ok;
+	bzero((void*)page_va, 4096);
+	job[4] = (2u<<1)|1u|(1u<<16);
+	job[8] = (uint32_t)(page_pa+0x800);
+	job[9] = (uint32_t)((page_pa+0x800)>>32);
+	job[10] = 6;
+	job[12] = 0xc0ffee01u;
+	FlushPoC_DcacheRegion(page_va, 4096);
+	rg_wr(gpu, AS0+AS_TRANSTAB_LO, 0);
+	rg_wr(gpu, AS0+AS_TRANSTAB_HI, 0);
+	rg_wr(gpu, AS0+0x30, 2);
+	rg_wr(gpu, AS0+0x34, 0);
+	rg_wr(gpu, AS0+AS_MEMATTR_LO, 0x88888888u);
+	rg_wr(gpu, AS0+AS_MEMATTR_HI, 0x88888888u);
+	rg_wr(gpu, AS0+AS_COMMAND, 1);
+	if (!rg_wait(gpu, AS0+AS_STATUS, 1, 0)) {
+		printf("ROSEMARY GPU: AS0 update timeout\n");
+		return 0;
+	}
+	rg_wr(gpu, JOB_INT_MASK, 0);
+	rg_wr(gpu, JOB_INT_CLEAR, 0xffffffffu);
+	rg_wr(gpu, JS1+JS_HEAD_NEXT_LO, (uint32_t)page_pa);
+	rg_wr(gpu, JS1+JS_HEAD_NEXT_HI, (uint32_t)(page_pa>>32));
+	rg_wr(gpu, JS1+JS_AFFINITY_NEXT_LO, shader_mask);
+	rg_wr(gpu, JS1+JS_AFFINITY_NEXT_HI, 0);
+	rg_wr(gpu, JS1+JS_CONFIG_NEXT, JS_CONFIG);
+	rg_wr(gpu, JS1+JS_COMMAND_NEXT, 1);
+	if (!rg_wait(gpu, JOB_INT_RAWSTAT, (1u<<1)|(1u<<17), 1u<<1)) {
+		printf("ROSEMARY GPU: job timeout, irq=%08x\n", rg_rd(gpu, JOB_INT_RAWSTAT));
+	}
+	FlushPoC_DcacheRegion(page_va, 4096);
+	ok = (*target == 0xc0ffee01u);
+	printf("ROSEMARY GPU: job: irq=%08x slot=%08x mmu=%08x job=%08x target=%08x%s\n",
+	    rg_rd(gpu, JOB_INT_RAWSTAT), rg_rd(gpu, JS1+JS_STATUS), rg_rd(gpu, AS0+AS_FAULTSTATUS),
+	    job[0], *target, ok?" OK":" FAIL");
+	rg_wr(gpu, JOB_INT_CLEAR, 0xffffffffu);
+	return ok;
+}
+
 void
 rosemary_gpu_probe(void)
 {
 	int mode = 1;
 	vm_offset_t spm, infra, topck, mfgcfg, gpu;
+	uint32_t shaders, tiler, l2, gpu_id;

 	if (PE_parse_boot_argn("rosemarygpu", &mode, sizeof(mode)) && mode == 0) {
@@ -287,5 +423,38 @@ rosemary_gpu_probe(void)
 	rg_wr(mfgcfg, RG_MFG_CG_CLR, RG_MFG_CG_BG3D);
 	printf("ROSEMARY GPU: MFG_CG_CON after ungate=%08x\n", rg_rd(mfgcfg, RG_MFG_CG_CON));
 	rg_read_gpu(gpu);
+	if (mode >= 3) {
+		vm_offset_t page_va = 0;
+		if (kmem_alloc(kernel_map, &page_va, 4096, KMA_KOBJECT|KMA_ZERO|KMA_DATA, 0) != KERN_SUCCESS) {
+			printf("ROSEMARY GPU: no page\n");
+			return;
+		}
+		gpu_id = rg_rd(gpu, GPU_ID);
+		shader_mask = rg_rd(gpu, SHADER_PRESENT);
+		shaders = shader_mask;
+		tiler = rg_rd(gpu, TILER_PRESENT);
+		l2 = rg_rd(gpu, L2_PRESENT);
+		rg_wr(gpu, GPU_INT_MASK, 0);
+		rg_wr(gpu, GPU_INT_CLEAR, 0xffffffffu);
+		rg_wr(gpu, GPU_CMD, 1);
+		if (!rg_wait(gpu, GPU_INT_RAWSTAT, IRQ_RESET_COMPLETED, IRQ_RESET_COMPLETED)) {
+			printf("ROSEMARY GPU: reset timeout\n");
+			kmem_free(kernel_map, page_va, 4096);
+			return;
+		}
+		rg_wr(gpu, GPU_INT_CLEAR, 0xffffffffu);
+		rg_wr(gpu, L2_PWRON, l2);
+		rg_wr(gpu, TILER_PWRON, tiler);
+		rg_wr(gpu, SHADER_PWRON, shaders);
+		if (!rg_wait(gpu, L2_READY, l2, l2) || !rg_wait(gpu, TILER_READY, tiler, tiler) ||
+		    !rg_wait(gpu, SHADER_READY, shaders, shaders)) {
+			printf("ROSEMARY GPU: cores timeout, ready=%08x\n", rg_rd(gpu, SHADER_READY));
+			kmem_free(kernel_map, page_va, 4096);
+			return;
+		}
+		printf("ROSEMARY GPU: Mali-G76 r%up%u cores ready\n", (gpu_id>>12)&0xf, (gpu_id>>4)&0xff);
+		if (rg_run_write_job(gpu, page_va, kvtophys(page_va)))
+			printf("ROSEMARY GPU: identity job SUCCESS\n");
+		kmem_free(kernel_map, page_va, 4096);
+	}
 }
 #endif /* ROSEMARY */

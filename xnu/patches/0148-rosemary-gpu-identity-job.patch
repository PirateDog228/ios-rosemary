+
+/* Bifrost GPU registers used for reset, core power and the first Job Manager test. */
+#define RG_GPU_ID                 0x000u
+#define RG_GPU_INT_RAWSTAT        0x020u
+#define RG_GPU_INT_CLEAR          0x024u
+#define RG_GPU_INT_MASK           0x028u
+#define RG_GPU_CMD                0x030u
+#define RG_GPU_RESET_COMPLETED    (1u << 8)
+#define RG_GPU_SHADER_PRESENT     0x100u
+#define RG_GPU_TILER_PRESENT      0x110u
+#define RG_GPU_L2_PRESENT         0x120u
+#define RG_GPU_SHADER_READY       0x140u
+#define RG_GPU_TILER_READY        0x150u
+#define RG_GPU_L2_READY           0x160u
+#define RG_GPU_SHADER_PWRON       0x180u
+#define RG_GPU_TILER_PWRON        0x190u
+#define RG_GPU_L2_PWRON           0x1a0u
+#define RG_GPU_JOB_INT_RAWSTAT    0x1000u
+#define RG_GPU_JOB_INT_CLEAR      0x1004u
+#define RG_GPU_JOB_INT_MASK       0x1008u
+#define RG_GPU_JS1                0x1880u
+#define RG_GPU_JS_STATUS          0x24u
+#define RG_GPU_JS_HEAD_NEXT_LO    0x40u
+#define RG_GPU_JS_HEAD_NEXT_HI    0x44u
+#define RG_GPU_JS_AFFINITY_NEXT_LO 0x50u
+#define RG_GPU_JS_AFFINITY_NEXT_HI 0x54u
+#define RG_GPU_JS_CONFIG_NEXT     0x58u
+#define RG_GPU_JS_COMMAND_NEXT    0x60u
+#define RG_GPU_JS_CONFIG          ((3u << 8) | (3u << 12) | (8u << 16))
+#define RG_GPU_AS0                0x2400u
+#define RG_GPU_AS_TRANSTAB_LO     0x00u
+#define RG_GPU_AS_TRANSTAB_HI     0x04u
+#define RG_GPU_AS_MEMATTR_LO      0x08u
+#define RG_GPU_AS_MEMATTR_HI      0x0cu
+#define RG_GPU_AS_COMMAND         0x18u
+#define RG_GPU_AS_FAULTSTATUS     0x1cu
+#define RG_GPU_AS_STATUS          0x28u
+#define RG_GPU_AS_TRANSCFG_LO     0x30u
+#define RG_GPU_AS_TRANSCFG_HI     0x34u
+#define RG_GPU_AS_COMMAND_UPDATE  1u
+#define RG_GPU_AS_IDENTITY        2u
+#define RG_GPU_JOB_DONE           (1u << 1)
+#define RG_GPU_JOB_EXCEPTION      (1u << 17)
+#define RG_GPU_JOB_TIMEOUT_US     100000u
+
+/* Soft reset: use RAWSTAT, not the masked interrupt output. */
+static int
+rg_gpu_soft_reset(vm_offset_t gpu)
+{
+	rg_wr(gpu, RG_GPU_INT_MASK, 0);
+	rg_wr(gpu, RG_GPU_INT_CLEAR, 0xffffffffu);
+	rg_wr(gpu, RG_GPU_CMD, 1u);
+	if (!rg_wait_for(gpu, RG_GPU_INT_RAWSTAT, RG_GPU_RESET_COMPLETED,
+	    RG_GPU_RESET_COMPLETED, 100000u)) {
+		printf("ROSEMARY GPU: soft reset timeout, GPU_INT_RAWSTAT=%08x GPU_STATUS=%08x\n",
+		    rg_rd(gpu, RG_GPU_INT_RAWSTAT), rg_rd(gpu, 0x034u));
+		return 0;
+	}
+	rg_wr(gpu, RG_GPU_INT_CLEAR, 0xffffffffu);
+	return 1;
+}
+
+/* Power the GPU's internal L2, tiler and shader blocks after the SoC MFG domains are up. */
+static int
+rg_gpu_power_cores(vm_offset_t gpu, uint32_t *shader_mask_out)
+{
+	uint32_t shader_mask = rg_rd(gpu, RG_GPU_SHADER_PRESENT);
+	uint32_t tiler_mask = rg_rd(gpu, RG_GPU_TILER_PRESENT);
+	uint32_t l2_mask = rg_rd(gpu, RG_GPU_L2_PRESENT);
+	uint32_t as_present = rg_rd(gpu, 0x018u);
+	uint32_t js_present = rg_rd(gpu, 0x01cu);
+
+	if (shader_mask == 0 || tiler_mask == 0 || l2_mask == 0 ||
+	    (as_present & 1u) == 0 || (js_present & (1u << 1)) == 0) {
+		printf("ROSEMARY GPU: invalid topology shader=%08x tiler=%08x l2=%08x AS=%08x JS=%08x\n",
+		    shader_mask, tiler_mask, l2_mask, as_present, js_present);
+		return 0;
+	}
+	rg_wr(gpu, RG_GPU_L2_PWRON, l2_mask);
+	rg_wr(gpu, RG_GPU_TILER_PWRON, tiler_mask);
+	rg_wr(gpu, RG_GPU_SHADER_PWRON, shader_mask);
+	if (!rg_wait_for(gpu, RG_GPU_L2_READY, l2_mask, l2_mask, 50000u) ||
+	    !rg_wait_for(gpu, RG_GPU_TILER_READY, tiler_mask, tiler_mask, 50000u) ||
+	    !rg_wait_for(gpu, RG_GPU_SHADER_READY, shader_mask, shader_mask, 50000u)) {
+		printf("ROSEMARY GPU: internal core power timeout: L2=%08x/%08x TILER=%08x/%08x SHADER=%08x/%08x\n",
+		    rg_rd(gpu, RG_GPU_L2_READY), l2_mask, rg_rd(gpu, RG_GPU_TILER_READY), tiler_mask,
+		    rg_rd(gpu, RG_GPU_SHADER_READY), shader_mask);
+		return 0;
+	}
+	*shader_mask_out = shader_mask;
+	printf("ROSEMARY GPU: internal cores ready: shader=%08x tiler=%08x l2=%08x\n",
+	    shader_mask, tiler_mask, l2_mask);
+	return 1;
+}
+
+/*
+ * Our GPU_ID is 0x7211xxxx. Panfrost normalizes MediaTek's 0x7xxx variant with
+ * (product & 0xf00f), yielding the standard Mali-G76 model ID 0x7001.
+ */
+static int
+rg_gpu_is_g76(vm_offset_t gpu)
+{
+	uint32_t id = rg_rd(gpu, RG_GPU_ID);
+	uint32_t product = id >> 16;
+	uint32_t panfrost_model = product & 0xf00fu;
+
+	uint32_t mmu_features = rg_rd(gpu, 0x014u);
+	printf("ROSEMARY GPU: model check product=%04x normalized=%04x revision=%04x MMU_FEATURES=%08x VA_BITS=%u PA_BITS=%u\n",
+	    product, panfrost_model, id & 0xffffu, mmu_features,
+	    mmu_features & 0xffu, (mmu_features >> 8) & 0xffu);
+	return panfrost_model == 0x7001u;
+}
+
+/* Configure address space 0 for identity mode: GPU VA is the physical address. */
+static int
+rg_gpu_as0_identity(vm_offset_t gpu)
+{
+	vm_offset_t as0 = gpu + RG_GPU_AS0;
+
+	rg_wr(as0, RG_GPU_AS_TRANSTAB_LO, 0);
+	rg_wr(as0, RG_GPU_AS_TRANSTAB_HI, 0);
+	rg_wr(as0, RG_GPU_AS_TRANSCFG_LO, RG_GPU_AS_IDENTITY);
+	rg_wr(as0, RG_GPU_AS_TRANSCFG_HI, 0);
+	rg_wr(as0, RG_GPU_AS_MEMATTR_LO, 0x88888888u);
+	rg_wr(as0, RG_GPU_AS_MEMATTR_HI, 0x88888888u);
+	rg_wr(as0, RG_GPU_AS_COMMAND, RG_GPU_AS_COMMAND_UPDATE);
+	if (!rg_wait_for(gpu, RG_GPU_AS0 + RG_GPU_AS_STATUS, 1u, 0u, 50000u)) {
+		printf("ROSEMARY GPU: AS0 identity update timeout, status=%08x fault=%08x\n",
+		    rg_rd(gpu, RG_GPU_AS0 + RG_GPU_AS_STATUS), rg_rd(gpu, RG_GPU_AS0 + RG_GPU_AS_FAULTSTATUS));
+		return 0;
+	}
+	printf("ROSEMARY GPU: AS0 configured for identity addressing\n");
+	return 1;
+}
+
+/*
+ * A minimal Bifrost Job Descriptor: write one immediate 32-bit value to page+0x800.
+ * Return 1 on success, 0 on a completed-but-failed job, and -1 if it timed out.
+ */
+static int
+rg_gpu_identity_write_job(vm_offset_t gpu, vm_offset_t page_va, uint64_t page_pa, uint32_t shader_mask)
+{
+	volatile uint32_t *job = (volatile uint32_t *)page_va;
+	volatile uint32_t *target = (volatile uint32_t *)(page_va + 0x800u);
+	uint32_t irq = 0;
+	int completed = 0;
+
+	bzero((void *)page_va, PAGE_SIZE);
+	job[4] = (2u << 1) | 1u | (1u << 16); /* WRITE_VALUE, 64-bit pointers, slot 1 */
+	job[8] = (uint32_t)(page_pa + 0x800u);
+	job[9] = (uint32_t)((page_pa + 0x800u) >> 32);
+	job[10] = 6u;                         /* 32-bit immediate */
+	job[12] = 0xc0ffee01u;
+	FlushPoC_DcacheRegion(page_va, PAGE_SIZE);
+
+	rg_wr(gpu, RG_GPU_JOB_INT_MASK, 0);
+	rg_wr(gpu, RG_GPU_JOB_INT_CLEAR, 0xffffffffu);
+	rg_wr(gpu, RG_GPU_JS1 + RG_GPU_JS_HEAD_NEXT_LO, (uint32_t)page_pa);
+	rg_wr(gpu, RG_GPU_JS1 + RG_GPU_JS_HEAD_NEXT_HI, (uint32_t)(page_pa >> 32));
+	rg_wr(gpu, RG_GPU_JS1 + RG_GPU_JS_AFFINITY_NEXT_LO, shader_mask);
+	rg_wr(gpu, RG_GPU_JS1 + RG_GPU_JS_AFFINITY_NEXT_HI, 0);
+	rg_wr(gpu, RG_GPU_JS1 + RG_GPU_JS_CONFIG_NEXT, RG_GPU_JS_CONFIG);
+	rg_wr(gpu, RG_GPU_JS1 + RG_GPU_JS_COMMAND_NEXT, 1u);
+
+	for (uint32_t elapsed = 0; elapsed < RG_GPU_JOB_TIMEOUT_US; elapsed += 10u) {
+		irq = rg_rd(gpu, RG_GPU_JOB_INT_RAWSTAT);
+		if (irq & RG_GPU_JOB_DONE) {
+			completed = 1;
+			break;
+		}
+		if (irq & RG_GPU_JOB_EXCEPTION) {
+			completed = 1;
+			break;
+		}
+		rg_delay_us(10);
+	}
+	if (!completed) {
+		printf("ROSEMARY GPU: identity job timeout, irq=%08x slot=%08x mmu=%08x fault=%08x\n",
+		    rg_rd(gpu, RG_GPU_JOB_INT_RAWSTAT), rg_rd(gpu, RG_GPU_JS1 + RG_GPU_JS_STATUS),
+		    rg_rd(gpu, 0x2000u), rg_rd(gpu, RG_GPU_AS0 + RG_GPU_AS_FAULTSTATUS));
+		return -1;
+	}
+
+	FlushPoC_DcacheRegion(page_va, PAGE_SIZE);
+	irq = rg_rd(gpu, RG_GPU_JOB_INT_RAWSTAT);
+	printf("ROSEMARY GPU: identity job irq=%08x slot=%08x job=%08x target=%08x fault=%08x\n",
+	    irq, rg_rd(gpu, RG_GPU_JS1 + RG_GPU_JS_STATUS), job[0], *target,
+	    rg_rd(gpu, RG_GPU_AS0 + RG_GPU_AS_FAULTSTATUS));
+	rg_wr(gpu, RG_GPU_JOB_INT_CLEAR, RG_GPU_JOB_DONE | RG_GPU_JOB_EXCEPTION);
+	return ((irq & RG_GPU_JOB_DONE) != 0 && (irq & RG_GPU_JOB_EXCEPTION) == 0 &&
+	    *target == 0xc0ffee01u) ? 1 : 0;
+}
+
+/* Mode 3 is opt-in and runs only after the already-tested MT6785 power sequence. */
+static void
+rg_gpu_test_identity_job(vm_offset_t gpu)
+{
+	vm_offset_t page_va = 0;
+	uint64_t page_pa;
+	uint32_t shader_mask = 0;
+	kern_return_t kr;
+	int result, safe_to_free = 1;
+
+	if (!rg_gpu_is_g76(gpu)) {
+		printf("ROSEMARY GPU: refusing job test on an unexpected GPU model\n");
+		return;
+	}
+	if (!rg_gpu_soft_reset(gpu) || !rg_gpu_power_cores(gpu, &shader_mask)) {
+		printf("ROSEMARY GPU: reset/core initialization failed; no job submitted\n");
+		return;
+	}
+
+	kr = kmem_alloc(kernel_map, &page_va, PAGE_SIZE,
+	    KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT);
+	if (kr != KERN_SUCCESS || page_va == 0) {
+		printf("ROSEMARY GPU: cannot allocate identity-job page (kr=%d)\n", kr);
+		return;
+	}
+	page_pa = kvtophys(page_va);
+	if (page_pa == 0 || (page_pa & (PAGE_SIZE - 1u)) != 0 || page_pa >= (1ULL << 40)) {
+		printf("ROSEMARY GPU: invalid physical address for job page: %llx\n", (unsigned long long)page_pa);
+		kmem_free(kernel_map, page_va, PAGE_SIZE);
+		return;
+	}
+	if (!rg_gpu_as0_identity(gpu)) {
+		kmem_free(kernel_map, page_va, PAGE_SIZE);
+		return;
+	}
+
+	result = rg_gpu_identity_write_job(gpu, page_va, page_pa, shader_mask);
+	if (result < 0) {
+		/* Never free a page while an uncompleted GPU job may still reference it. */
+		safe_to_free = rg_gpu_soft_reset(gpu);
+		if (safe_to_free) {
+			uint32_t ignored_mask;
+			(void)rg_gpu_power_cores(gpu, &ignored_mask);
+		} else {
+			printf("ROSEMARY GPU: keeping the test page allocated; GPU reset did not complete\n");
+		}
+	}
+	if (safe_to_free) {
+		kmem_free(kernel_map, page_va, PAGE_SIZE);
+	}
+	printf("ROSEMARY GPU: identity job %s\n", result == 1 ? "SUCCESS" : "FAILED");
+}
+
 void
 rosemary_gpu_probe(void)
 {
@@ -242,5 +501,8 @@ rosemary_gpu_probe(void)
 	rg_wr(mfgcfg, RG_MFG_CG_CLR, RG_MFG_CG_BG3D);
 	printf("ROSEMARY GPU: MFG_CG_CON after ungate=%08x\n", rg_rd(mfgcfg, RG_MFG_CG_CON));
 	rg_read_gpu(gpu);
+	if (mode >= 3) {
+		rg_gpu_test_identity_job(gpu);
+	}
 }
 #endif /* ROSEMARY */

+			}
+			memcpy(hdr, buf, sizeof(hdr));
+		} else if (i2c_read(FT_ADDR, &zero, 1, hdr, sizeof(hdr))) {
 			if ((errors++ % 500u) == 0) {
 				printf("ROSEMARY TOUCH: read error\n");

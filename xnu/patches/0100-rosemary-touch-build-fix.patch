-					printf("ROSEMARY TOUCH: frame n=%d p0 %02x %02x %02x %02x %02x %02x int=%u\n", n, p[0], p[1], p[2], p[3], p[4], p[5], lvl);
-				}
-			}
-			if (event || active[id]) {
-				if (event) {
-					last_event = now_ns;
-				}
-				if (now_ns - last_event < rel_ms * NSEC_PER_MSEC) {

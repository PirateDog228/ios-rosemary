 					sweet_hid_touch(id, 1, x, y);
 				}
 			}
 		}
 check_release:
-		if (now_ns - last_event >= rel_ms * NSEC_PER_MSEC) {
+		if (rel_ms && now_ns - last_event >= rel_ms * NSEC_PER_MSEC) {
 			if (any_active(active) && g_count++ < 80) {

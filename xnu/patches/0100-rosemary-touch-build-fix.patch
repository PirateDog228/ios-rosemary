-	 * The FT3418 never reports "no touch" after the first contact (reg 2 stays 1 and
-	 * the last point stays frozen), so a lift is detected by silence: no INT edge and
-	 * no change of the reported point for RELEASE_MS. INT (GPIO1) is sampled every ms.
+	 * Read a complete point frame once a contact appears, and then on every active
+	 * poll. Reading the count and point payload in separate transactions can mix
+	 * controller frames. Some firmware leaves a stale point after lift, so keep the
+	 * configurable silence fallback; explicit all-up and per-point up reports win.
 	 */
 	uint64_t last_event = 0, last_poll = 0;
 	unsigned int_prev = 1, edges = 0;
-	uint8_t prev[6] = { 0 };
+	uint8_t prev[10][6] = { { 0 } };
 	uint64_t g_start = 0, g_last = 0, g_maxgap = 0;
 	unsigned g_changes = 0, g_loops = 0, g_count = 0, loops = 0;
 
 	for (;;) {
-		uint8_t hdr[3], buf[3 + 6 * 10], zero = 0;
+		uint8_t hdr[3] = { 0 }, buf[3 + 6 * 10], zero = 0;
 		uint64_t now_ns;
-		bool event = false;
+		bool full = any_active(active);
 
 		sleep_ms(1);
 		loops++;
@@ -385,31 +386,70 @@
 		if (edge) {

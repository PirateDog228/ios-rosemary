-		}
-		int n = hdr[2] & 0x0f;
-
-		if (n == 0 || n > 10) {
-			goto check_release;
-		}
-		if (i2c_read(FT_ADDR, &zero, 1, buf, 3 + 6 * n)) {
-			continue;
 		}
 		for (int i = 0; i < n; i++) {
 			const uint8_t *p = buf + 3 + 6 * i;
@@ -417,6 +457,7 @@
 			int x = ((p[0] & 0x0f) << 8) | p[1];
 			int id = p[2] >> 4;
 			int y = ((p[2] & 0x0f) << 8) | p[3];

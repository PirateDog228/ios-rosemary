-			continue;
+			goto check_release;
+		}
+		int n = hdr[2] & 0x0f;
+		if (n > 10) {
+			goto check_release;
+		}
+		if (n == 0) {
+			for (int i = 0; i < 10; i++) {
+				if (active[i]) {
+					active[i] = false;
+					sweet_hid_touch(i, 0, 0, 0);
+				}
+			}
+			memset(prev, 0, sizeof(prev));
+			last_event = now_ns;
+			goto check_release;
+		}
+		if (!full) {
+			if (i2c_read(FT_ADDR, &zero, 1, buf, sizeof(buf))) {
+				if ((errors++ % 500u) == 0) {
+					printf("ROSEMARY TOUCH: frame read error\n");
+				}
+				goto check_release;
+			}
+			memcpy(hdr, buf, sizeof(hdr));
+			n = hdr[2] & 0x0f;
+			if (n > 10) {
+				goto check_release;
+			}
+			if (n == 0) {
+				for (int i = 0; i < 10; i++) {
+					if (active[i]) {
+						active[i] = false;
+						sweet_hid_touch(i, 0, 0, 0);
+					}
+				}
+				memset(prev, 0, sizeof(prev));
+				last_event = now_ns;
+				goto check_release;
+			}
 		}
 		errors = 0;
 		polls++;

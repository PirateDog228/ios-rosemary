diff --git a/bsd/dev/rosemary_touch.c b/bsd/dev/rosemary_touch.c
--- a/bsd/dev/rosemary_touch.c
+++ b/bsd/dev/rosemary_touch.c
@@ -357,22 +357,23 @@
 		printf("ROSEMARY TOUCH: FT3418 not found, giving up\n");
 		return;
 	}
-	printf("ROSEMARY TOUCH: running\n");
+	printf("ROSEMARY TOUCH: running (release timeout=%u ms; 0 disables fallback)\n", rel_ms);

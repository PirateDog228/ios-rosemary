Subject: rosemary-0168: security.mac.amfi sysctl node and answers for every AMFI mac_syscall (ExtensionKit found no AMFI: no app extensions, no wallpapers)

diff --git a/bsd/kern/sweet_amfi.c b/bsd/kern/sweet_amfi.c
--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -36,6 +36,23 @@
 #include <sys/vnode.h>
 #include <security/mac_policy.h>
 #include <pexpert/pexpert.h>
+#include <sys/sysctl.h>
+
+/*
+ * 0168: AMFI's sysctl node, which the AMFI kext makes on a device: libamfi's amfi_developer_mode_status()
+ * reads security.mac.amfi.developer_mode_status (8 bytes, 1 = on) and ExtensionKit wants it when it reads
+ * the extension cache (/System/Library/xpc/extensions.plist). Without the node: "Unable to find AMFI", no
+ * extension point in LaunchServices, PlugInKit -10814 everywhere, no wallpapers (poster extensions),
+ * widgets or file providers. Found in ios-topaz 0147/0150.
+ */
+SYSCTL_DECL(_security_mac);
+SYSCTL_NODE(_security_mac, OID_AUTO, amfi, CTLFLAG_RW | CTLFLAG_LOCKED, 0, "AMFI");
+static uint64_t sweet_amfi_developer_mode = 1;
+static uint64_t sweet_amfi_qa_root_certs = 0;
+SYSCTL_QUAD(_security_mac_amfi, OID_AUTO, developer_mode_status, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &sweet_amfi_developer_mode, "developer mode (on: nothing is restricted here)");
+SYSCTL_QUAD(_security_mac_amfi, OID_AUTO, qa_root_certs_allowed, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &sweet_amfi_qa_root_certs, "");
 
 /* iokit/Kernel/arm/SweetEntitlements.cpp */
 void *sweet_entitlements_create(const CS_GenericBlob *blob, size_t blob_len);
@@ -340,7 +357,24 @@
 	} args;
 	static int seen;
 
-	if (call != SWEET_AMFI_DYLD_POLICY_CALL || !sweet_amfi_dyld_open) {
+	if (call != SWEET_AMFI_DYLD_POLICY_CALL) {
+		/*
+		 * 0168: any other call (libamfi asks AMFI by policy name, e.g. amfi_interface_query_bootarg_state()
+		 * from ExtensionFoundation) succeeds and leaves the caller's output alone: no flags, nothing special.
+		 * Without a policy that answers, lsd's ExtensionKit says "Unable to find AMFI".
+		 */
+		static uint64_t other_seen;
+
+		if (call >= 0 && call < 64 && !(other_seen & (1ULL << call))) {
+			char name[32];
+
+			other_seen |= 1ULL << call;
+			proc_name(proc_pid(p), name, sizeof(name));
+			printf("SWEET AMFI: syscall %d from %s\n", call, name);
+		}
+		return 0;
+	}
+	if (!sweet_amfi_dyld_open) {
 		return ENOSYS;
 	}
 	if (copyin(arg, &args, sizeof(args)) != 0) {

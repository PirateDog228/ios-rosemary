+/* 0119: allocate ONE packet-header mbuf with a single contiguous cluster and
+ * set both lengths explicitly. mbuf_allocpacket() returns, for sizes between
+ * MHLEN and MINCLSIZE, a chain of mbufs with m_len == 0; the following
+ * mbuf_len(m) - ETHER_HDR_LEN then became -14 and ifnet_input() panicked with
+ * "Failed mbuf validity check ... len -14". */
+static mbuf_t ru_mbuf_alloc_contig(size_t len)
+{
+	mbuf_t m = NULL;
+	size_t csize;
+	if (len == 0u || len > 16384u) return NULL;
+	csize = (len <= 2048u) ? 2048u : ((len <= 4096u) ? 4096u : 16384u);
+	if (mbuf_gethdr(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0 || m == NULL) return NULL;
+	if (mbuf_getcluster(MBUF_DONTWAIT, MBUF_TYPE_DATA, csize, &m) != 0 || m == NULL) {
+		if (m != NULL) mbuf_freem(m);
+		return NULL;
+	}
+	if (mbuf_trailingspace(m) < len) {
+		mbuf_freem(m);
+		return NULL;
+	}
+	mbuf_setlen(m, len);
+	mbuf_pkthdr_setlen(m, len);
+	return m;
+}

diff --git a/iokit/Kernel/arm/SweetSurface.cpp b/iokit/Kernel/arm/SweetSurface.cpp
--- a/iokit/Kernel/arm/SweetSurface.cpp
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -794,8 +794,14 @@
 	}
 	if (ret == kIOReturnSuccess && client_address != NULL) {
 		bool client_read_only = false;
-		uint64_t used = (uint64_t)s->offset + (uint64_t)s->bytesPerRow *
-		    sweet_div_up(s->height, s->elementHeight);
+		/*
+		 * 0171: what the creator's memory must hold at least: the last row is only as long as the pixels
+		 * in it, not bytesPerRow (QuartzCore's 256x1 tables: bytesPerRow 0x2a0, IOSurfaceAllocSize 0x200;

+		uint64_t used = (uint64_t)s->offset + (rows > 0 ? (rows - 1) * (uint64_t)s->bytesPerRow + last_row : 0);
 		for (uint32_t i = 0; i < s->planeCount; i++) {
 			uint64_t plane_end = (uint64_t)s->planes[i].offset + s->planes[i].size;

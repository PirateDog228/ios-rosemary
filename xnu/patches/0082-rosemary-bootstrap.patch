diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
index b99c2f4..50650b8 100644
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -43,11 +43,25 @@
 #endif /* ! ASSEMBLER */
 
 /*
- * Qualcomm numbers the architected timer PPIs 1/2/3/0 (secure phys, phys,
- * virt, hyp) instead of the usual 13/14/11/10: the virtual timer XNU uses
- * (CNTV) is INTID 16 + 3 = 19.
+ * Timer PPI numbers are board-specific: Qualcomm uses 3 (INTID 19), while
+ * MT6785 uses 11 (INTID 27). The Rosemary ADT also publishes the live value.
  */
+#if defined(ROSEMARY)
+/* MT6785's architected virtual timer PPI is 11, GIC INTID 16 + 11 = 27. */
+#define SWEET_EARLY_FB_BASE       0x7bd20000
+#define SWEET_EARLY_FB_MAP_BASE   0x7a000000
+#define SWEET_EARLY_FB_OFFSET     0x01d20000
+#define SWEET_EARLY_FB_STRIDE     4352
+#define SWEET_EARLY_FB_MAP_BLOCKS 2
+#define SWEET_VTIMER_INTID        27
+#else
+#define SWEET_EARLY_FB_BASE       0x9c000000
+#define SWEET_EARLY_FB_MAP_BASE   0x9c000000
+#define SWEET_EARLY_FB_OFFSET     0
+#define SWEET_EARLY_FB_STRIDE     4320
+#define SWEET_EARLY_FB_MAP_BLOCKS 1
 #define SWEET_VTIMER_INTID        19
+#endif
 #define SWEET_IPI_SGI             1       // SGI used for cross-CPU signals
 
 #define GIC_SPURIOUS_IRQ          1023    // IRQ no. for GIC spurious interrupt

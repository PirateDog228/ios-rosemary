diff --git a/bsd/dev/rosemary_mali.c b/bsd/dev/rosemary_mali.c
index ffb833c..a3fd1c6 100644
--- a/bsd/dev/rosemary_mali.c
+++ b/bsd/dev/rosemary_mali.c
@@ -41,8 +41,11 @@ extern uint64_t kvtophys(vm_offset_t va);
 extern vm_offset_t phystokv(uint64_t pa);
 extern void FlushPoC_DcacheRegion(vm_offset_t va, size_t length);
 extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern kern_return_t thread_terminate(thread_t);                 /* osfmk/kern/thread.c, not in the headers this file sees */
+extern wait_result_t thread_block(thread_continue_t);
 
 int rosemary_mali_attach(vm_offset_t gpu_regs, uint32_t shader_mask);
+extern bool RosemaryMaliStart(void);            /* iokit/Kernel/arm/RosemaryMali.cpp */
 bool rosemary_mali_ready(void);

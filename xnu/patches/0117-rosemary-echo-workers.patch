+/* 0117: several workers accept on the same listening socket, so one stuck or
+ * idle connection (e.g. a client that vanished without an RST) cannot block
+ * every later connection behind it. */
+#define RU_ECHO_WORKERS 4
+static volatile uint32_t ru_echo_accepts;
+
+static void ru_echo_accept_loop(socket_t ls)
+{
+	for (;;) {
+		socket_t cs = NULL;
+		errno_t e = sock_accept(ls, NULL, 0, 0, NULL, NULL, &cs);
+		if (e != 0) {
+			printf("ROSEMARY ECHO: accept err=%d\n", e);
+			ru_sleep_ms(1000);
+			continue;
+		}
+		printf("ROSEMARY ECHO: accepted #%u\n", ++ru_echo_accepts);
+		ru_echo_conn(cs);
+		printf("ROSEMARY ECHO: connection closed\n");
+	}
+}
+
+static void ru_echo_worker(void *arg, wait_result_t w __unused)
+{
+	ru_echo_accept_loop((socket_t)arg);
+}
+
 static void ru_echo_thread(void *arg __unused, wait_result_t w __unused)

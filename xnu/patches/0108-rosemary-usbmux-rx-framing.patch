+/* Treat bulk OUT completions as a byte stream rather than assuming each QMU
+ * completion contains one whole USBMUX frame. This also recognizes v2 magic
+ * even if endpoint reconfiguration reset the negotiated-version variable. */
+static void ru_mux_rx_feed(const uint8_t *packet, uint32_t len)
+{
+	if (packet == NULL || len == 0u) return;
+	if (ru.mux_rx_accum_len > RU_MUX_RX_ACCUM_MAX ||
+	    len > RU_MUX_RX_ACCUM_MAX - ru.mux_rx_accum_len) {
+		printf("ROSEMARY USB: USBMUX RX accumulator overflow used=%u incoming=%u; resetting\n",
+		    ru.mux_rx_accum_len, len);
+		ru.mux_rx_accum_len = 0;
+		if (len > RU_MUX_RX_ACCUM_MAX) return;
+	}
+	bcopy(packet, ru.mux_rx_accum + ru.mux_rx_accum_len, len);
+	ru.mux_rx_accum_len += len;
+
+	while (ru.mux_rx_accum_len >= RUMUX_V1_HEADER_SIZE) {
+		const uint8_t *buf = ru.mux_rx_accum;
+		uint32_t protocol = rosemary_usbmux_get_be32(buf);
+		uint32_t total = rosemary_usbmux_get_be32(buf + 4);
+		uint32_t header_len;
+
+		if (ru.mux_version >= 2u ||
+		    (ru.mux_rx_accum_len >= RUMUX_V2_HEADER_SIZE &&
+		     rosemary_usbmux_get_be32(buf + 8) == RUMUX_MAGIC_V2)) {
+			header_len = RUMUX_V2_HEADER_SIZE;
+		} else if (ru.mux_version == 1u ||
+		    (protocol == RUMUX_PROTO_VERSION && ru.mux_state == RU_MUX_WAIT_VERSION)) {
+			header_len = RUMUX_V1_HEADER_SIZE;
+		} else if (ru.mux_rx_accum_len < RUMUX_V2_HEADER_SIZE) {
+			/* Wait for enough bytes to distinguish a v2 header from v1. */
+			return;
+		} else {
+			header_len = RUMUX_V1_HEADER_SIZE;
+		}
+
+		if (total < header_len || total > RU_MUX_RX_ACCUM_MAX) {
+			printf("ROSEMARY USB: USBMUX invalid frame header proto=%u total=%u used=%u header=%u\n",
+			    protocol, total, ru.mux_rx_accum_len, header_len);
+			ru.mux_rx_accum_len = 0;
+			return;
+		}
+		/* If the 17-byte SETUP lost its final 07 but the next frame is already
+		 * buffered, do not consume that next frame's first byte as SETUP data. */
+		if (header_len == RUMUX_V2_HEADER_SIZE && protocol == RUMUX_PROTO_SETUP &&
+		    total == 17u && ru.mux_rx_accum_len > total && buf[16] != 0x07u &&
+		    (ru.mux_state == RU_MUX_WAIT_SETUP || ru.mux_state == RU_MUX_WAIT_VERSION)) {
+			printf("ROSEMARY USB: incomplete USBMUX SETUP; resyncing stream boundary\n");
+			ru.mux_rx_accum_len -= RUMUX_V2_HEADER_SIZE;
+			memmove(ru.mux_rx_accum, ru.mux_rx_accum + RUMUX_V2_HEADER_SIZE,
+			    ru.mux_rx_accum_len);
+			continue;
+		}
+		if (ru.mux_rx_accum_len < total) return;
+		ru_mux_rx_packet(buf, total);
+		ru.mux_rx_accum_len -= total;
+		if (ru.mux_rx_accum_len != 0u) {
+			memmove(ru.mux_rx_accum, ru.mux_rx_accum + total, ru.mux_rx_accum_len);
+		}
+	}
+}

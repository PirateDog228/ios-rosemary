-	if (len != 0u) {
-		ru_mux_rx_packet((const uint8_t *)(ru.dma + RU_RX_BUFFER_OFF), len);
-	}
+	/* Save completed bytes and re-arm OUT before protocol/TCP processing. A
+	 * host may send SETUP immediately after receiving the VERSION reply. */
+	if (len != 0u) bcopy((const void *)(ru.dma + RU_RX_BUFFER_OFF), ru.rx_packet_copy, len);
 	if (!ru_rx_arm()) {
 		ru.rx_errors++;
 		ru.rx_active = 0;
 		printf("ROSEMARY USB: RX QMU re-arm failed\n");
+		return;
 	}
+	if (len != 0u) ru_mux_rx_feed(ru.rx_packet_copy, len);
 }

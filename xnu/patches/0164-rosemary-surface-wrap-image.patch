+/*
+ * Selector 6: a surface made of memory the caller already has (CoreAnimation in the window server gets a picture
+ * from another process as plain memory and wraps it for OpenGL). What the call is given (seen in the log of 0163):
+ * the address in the caller's task, then width, height, pixel format, bytes an element, bytes a row and the size
+ * in bytes of what is there (not rounded up to a page; the address need not be at the start of one).
+ * The answer is the same description a create gives. Nothing is copied: the surface is the caller's pages, kept
+ * (kIOMemoryPersistent) and wired for as long as the surface lives, and the base address the library is told
+ * is the caller's own. Not offered to the Mali (RosemaryMali.cpp surfaceBuffer): its size is not pages.
+ */
+IOReturn
+IOSurfaceRootUserClient::wrapImage(IOExternalMethodArguments *args)
+{
+	struct {
+		uint64_t address;
+		uint32_t width, height, pixelFormat, bytesPerElement, bytesPerRow, size;
+	} in;
+	static uint32_t logged;
+	static int enabled = -1;
+	char name[32];
+	IOReturn ret;
+
+	if (enabled < 0) {
+		int value = 1;
+
+		PE_parse_boot_argn("surfwrap", &value, sizeof(value));   /* surfwrap=0: refuse the call, as before 0164 */
+		enabled = value != 0;
+	}
+	if (!enabled) {
+		return kIOReturnUnsupported;
+	}
+	if (args->structureInput == NULL || args->structureInputSize != sizeof(in) || args->structureOutputSize < SWEET_SURFACE_RESULT_SIZE) {
+		return kIOReturnBadArgument;
+	}
+	memcpy(&in, args->structureInput, sizeof(in));
+	if (in.address == 0 || in.width == 0 || in.height == 0 || in.width > SWEET_SURFACE_MAX_DIM || in.height > SWEET_SURFACE_MAX_DIM ||
+	    in.bytesPerElement == 0 || in.bytesPerElement > 64 || in.bytesPerRow < (uint64_t)in.width * in.bytesPerElement ||
+	    in.size < (uint64_t)in.bytesPerRow * (in.height - 1) + (uint64_t)in.width * in.bytesPerElement || in.size > SWEET_SURFACE_MAX_ALLOC) {
+		return kIOReturnBadArgument;
+	}
+	SweetSurface *s = sweet_surface_alloc();
+	if (s == NULL) {
+		return kIOReturnNoMemory;
+	}
+	s->width = in.width;
+	s->height = in.height;
+	s->bytesPerRow = in.bytesPerRow;
+	s->bytesPerElement = (uint16_t)in.bytesPerElement;
+	s->elementWidth = s->elementHeight = 1;
+	s->pixelFormat = in.pixelFormat;
+	s->allocSize = in.size;
+	s->wrapOffset = (uint32_t)(in.address & (page_size - 1));
+	s->mapCache = kIOMapDefaultCache;
+	s->memory = IOMemoryDescriptor::withAddressRange(in.address, in.size, kIODirectionInOut | kIOMemoryPersistent, fTask);
+	if (s->memory == NULL) {
+		ret = kIOReturnVMError;
+	} else if (s->memory->prepare() != kIOReturnSuccess) {
+		ret = kIOReturnVMError;
+	} else {
+		s->wrapped = true;              /* (so that free() completes what is prepared) */
+		ret = sweet_surface_publish(s) ? kIOReturnSuccess : kIOReturnNoResources;
+	}
+	proc_selfname(name, sizeof(name));
+	if (ret != kIOReturnSuccess || logged++ < 32) {
+		IOLog("SWEET SURF: %s wrap %ux%u fmt 0x%x bpe %u bpr %u size %u at 0x%llx -> id %u 0x%x\n", name, in.width, in.height, in.pixelFormat,
+		    in.bytesPerElement, in.bytesPerRow, in.size, in.address, s->id, ret);
+	}
+	if (ret != kIOReturnSuccess) {
+		s->release();
+		return ret;
+	}
+	ret = returnSurface(s, args);           /* takes the creator's user count */
+	s->release();
+	return ret;
+}

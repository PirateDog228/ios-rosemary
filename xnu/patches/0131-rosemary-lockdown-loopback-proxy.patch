+	 * kernel peer; terminate its TCP here instead of injecting into rmx0. */
+	if (local_port == RU_LOOP_PORT) {
+		return ru_loop_tcp_input(segment, tcp_len);
+	}
+
 	bcopy(segment, tcp_header, tcp_hlen);
 	tcp_header[16] = 0;
 	tcp_header[17] = 0;
@@ -1325,6 +1712,7 @@ static void ru_tx_reset_mux(void)
 	ru.mux_rx_accum_len = 0;
 	bzero(ru.mux_tcp_map, sizeof(ru.mux_tcp_map));
 	ru.mux_tcp_map_next = 0;
+	ru_loop_reset_all_locked();
 	lck_mtx_unlock(ru.tx_lock);
 }
 
@@ -1861,6 +2249,7 @@ static void ru_usb_thread(void *arg, wait_result_t result)
 		}
 		ru_tx_poll();

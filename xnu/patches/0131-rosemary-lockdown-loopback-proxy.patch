+/* --- lockdownd loopback bridge (port 62078) ---------------------------- */
+
+static int ru_loop_find_locked(uint16_t peer_port)
+{
+	for (uint32_t i = 0; i < RU_LOOP_DEPTH; i++) {
+		if (ru.loop[i].valid && ru.loop[i].peer_port == peer_port) return (int)i;
+	}
+	return -1;
+}
+
+static int ru_loop_alloc_locked(uint16_t peer_port)
+{
+	for (uint32_t i = 0; i < RU_LOOP_DEPTH; i++) {
+		if (!ru.loop[i].valid) {
+			bzero(&ru.loop[i], sizeof(ru.loop[i]));
+			ru.loop[i].valid = 1;
+			ru.loop[i].peer_port = peer_port;
+			return (int)i;
+		}
+	}
+	return -1;
+}
+
+/* ru.tx_lock must be held; may be called with so == NULL. */
+static void ru_loop_close_locked(int idx)
+{
+	socket_t so;
+	if (idx < 0 || idx >= (int)RU_LOOP_DEPTH || !ru.loop[idx].valid) return;
+	so = ru.loop[idx].so;
+	bzero(&ru.loop[idx], sizeof(ru.loop[idx]));
+	if (so != NULL) sock_close(so);
+}
+
+static void ru_loop_reset_all_locked(void)
+{
+	for (uint32_t i = 0; i < RU_LOOP_DEPTH; i++) {
+		if (ru.loop[i].valid) ru_loop_close_locked((int)i);
+	}
+}
+
+/* Build one bare TCP segment (no Ethernet/IP) addressed from RU_LOOP_PORT to
+ * peer_port, frame it as a normal USBMUX TCP packet, and queue it exactly
+ * like ru_mux_tx_tcp_mbuf does. The checksum uses the same synthetic
+ * 198.18.0.2 -> 198.18.0.1 pseudo-header usbmuxd already expects, since this
+ * is still carried over the same mux wire protocol - only the IP/Ethernet
+ * injection into XNU's real stack is skipped for this port. */
+static void ru_loop_tx_segment(uint16_t peer_port, uint32_t seq, uint32_t ack,
+    uint8_t flags, const uint8_t *payload, uint32_t paylen)
+{
+	uint8_t tcp_header[20];
+	uint8_t pseudo[12];
+	uint32_t sum, tcp_len, header_len, total_len, idx;
+	uint16_t tcp_sum;
+	uint8_t *out;
+
+	tcp_len = (uint32_t)sizeof(tcp_header) + paylen;
+	if (tcp_len > RU_MUX_TX_FRAME_MAX - RUMUX_V2_HEADER_SIZE) {
+		printf("ROSEMARY USB: loopback segment too large len=%u\n", tcp_len);
+		return;
+	}
+
+	bzero(tcp_header, sizeof(tcp_header));
+	rosemary_usbmux_put_be16(tcp_header + 0, (uint16_t)RU_LOOP_PORT);
+	rosemary_usbmux_put_be16(tcp_header + 2, peer_port);
+	rosemary_usbmux_put_be32(tcp_header + 4, seq);
+	rosemary_usbmux_put_be32(tcp_header + 8, ack);
+	tcp_header[12] = (uint8_t)(5u << 4); /* data offset = 5 words, no options */
+	tcp_header[13] = flags;
+	rosemary_usbmux_put_be16(tcp_header + 14, 32768u); /* window */
+
+	{
+		uint32_t src_ip = htonl(RU_MUX_DEVICE_IP);
+		uint32_t dst_ip = htonl(RU_MUX_HOST_IP);
+		bcopy(&src_ip, pseudo, 4);
+		bcopy(&dst_ip, pseudo + 4, 4);
+	}
+	pseudo[8] = 0;
+	pseudo[9] = IPPROTO_TCP;
+	pseudo[10] = (uint8_t)(tcp_len >> 8);
+	pseudo[11] = (uint8_t)tcp_len;
+	sum = ru_checksum_add(0, pseudo, sizeof(pseudo));
+	sum = ru_checksum_add(sum, tcp_header, sizeof(tcp_header));
+	if (paylen != 0u) sum = ru_checksum_add(sum, payload, paylen);
+	tcp_sum = ru_checksum_finish(sum);
+	tcp_header[16] = (uint8_t)(tcp_sum >> 8);
+	tcp_header[17] = (uint8_t)tcp_sum;
+
+	if (!ru.tx_lock) return;
+	lck_mtx_lock(ru.tx_lock);
+	if (ru.mux_state != RU_MUX_ACTIVE || ru.mux_version == 0u ||
+	    ru.txq_count >= RU_MUX_TXQ_DEPTH) {
+		ru.tx_errors++;
+		lck_mtx_unlock(ru.tx_lock);
+		return;
+	}
+	header_len = (ru.mux_version >= 2u) ? RUMUX_V2_HEADER_SIZE : RUMUX_V1_HEADER_SIZE;
+	total_len = header_len + tcp_len;
+	if (total_len > RU_MUX_TX_FRAME_MAX) {
+		ru.tx_errors++;
+		lck_mtx_unlock(ru.tx_lock);
+		return;
+	}
+	idx = (ru.txq_head + ru.txq_count) % RU_MUX_TXQ_DEPTH;
+	out = ru.txq[idx].data;
+	rosemary_usbmux_put_be32(out, RUMUX_PROTO_TCP);
+	rosemary_usbmux_put_be32(out + 4, total_len);
+	if (ru.mux_version >= 2u) {
+		rosemary_usbmux_put_be32(out + 8, RUMUX_MAGIC_V2);
+		rosemary_usbmux_put_be16(out + 12, ru.mux_tx_seq++);
+		rosemary_usbmux_put_be16(out + 14, ru.mux_rx_seq);
+	}
+	bcopy(tcp_header, out + header_len, sizeof(tcp_header));
+	if (paylen != 0u) bcopy(payload, out + header_len + sizeof(tcp_header), paylen);
+	ru.txq[idx].len = (uint16_t)total_len;
+	ru.txq_count++;
+	ru.mux_tcp_out_count++;
+	printf("ROSEMARY USB: loopback TCP OUT 62078->%u flags=%02x seq=%u ack=%u bytes=%u\n",
+	    peer_port, flags, seq, ack, paylen);
+	ru_tx_kick_locked();
+	lck_mtx_unlock(ru.tx_lock);
+}
+
+/* Handle one TCP segment addressed to RU_LOOP_PORT. Unlike ru_mux_tcp_input,
+ * this never touches rmx0/ifnet_input: on SYN it opens a genuine kernel
+ * socket to 127.0.0.1:62078 (sock_socket+sock_connect, exactly as
+ * AppleUSBMux does on a real iPhone, so lockdownd's peer_is_safe() sees pid
+ * 0), then shuttles bytes between that socket and usbmuxd's simplified TCP,
+ * which this function terminates itself. Runs only on the single-threaded
+ * ru_usb_thread, so the ru.loop[] table needs no locking beyond what is
+ * already needed to share ru.txq with the network stack's output callback. */
+static int ru_loop_tcp_input(const uint8_t *segment, uint32_t tcp_len)
+{
+	struct tcphdr th;
+	uint16_t peer_port;
+	uint32_t seg_seq, seg_ack, paylen;
+	uint8_t flags;
+	size_t tcp_hlen;
+	const uint8_t *payload;
+	int idx;
+
+	if (tcp_len < sizeof(struct tcphdr)) return 0;
+	tcp_hlen = (size_t)((segment[12] >> 4) & 0x0fu) * 4u;
+	if (tcp_hlen < sizeof(struct tcphdr) || tcp_hlen > tcp_len) return 0;
+	bcopy(segment, &th, sizeof(th));
+	peer_port = ntohs(th.th_sport);
+	flags = th.th_flags;
+	seg_seq = ntohl(th.th_seq);
+	seg_ack = ntohl(th.th_ack);
+	payload = segment + tcp_hlen;
+	paylen = tcp_len - (uint32_t)tcp_hlen;
+
+	if ((flags & TH_SYN) != 0u && (flags & TH_ACK) == 0u) {
+		socket_t so = NULL;
+		struct sockaddr_in sin;
+		errno_t err;
+		uint32_t our_isn;
+
+		lck_mtx_lock(ru.tx_lock);
+		idx = ru_loop_find_locked(peer_port);
+		if (idx >= 0) ru_loop_close_locked(idx);
+		idx = ru_loop_alloc_locked(peer_port);
+		lck_mtx_unlock(ru.tx_lock);
+		if (idx < 0) {
+			printf("ROSEMARY USB: loopback SYN %u->62078: no free slot\n", peer_port);
+			return 1;
+		}
+
+		bzero(&sin, sizeof(sin));
+		sin.sin_len = sizeof(sin);
+		sin.sin_family = AF_INET;
+		sin.sin_port = htons((uint16_t)RU_LOOP_PORT);
+		sin.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+		err = sock_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP, NULL, NULL, &so);
+		if (err == 0) err = sock_connect(so, (struct sockaddr *)&sin, 0);
+		if (err != 0) {
+			printf("ROSEMARY USB: loopback connect 127.0.0.1:%u failed err=%d\n",
+			    RU_LOOP_PORT, err);
+			if (so != NULL) sock_close(so);
+			lck_mtx_lock(ru.tx_lock);
+			ru_loop_close_locked(idx);
+			lck_mtx_unlock(ru.tx_lock);
+			ru_loop_tx_segment(peer_port, seg_seq + 1u, 0u, TH_RST | TH_ACK, NULL, 0u);
+			return 1;
+		}
+
+		our_isn = (uint32_t)ru_counter();
+		lck_mtx_lock(ru.tx_lock);
+		if (ru.loop[idx].valid && ru.loop[idx].peer_port == peer_port) {
+			ru.loop[idx].so = so;
+			ru.loop[idx].peer_seq = seg_seq + 1u;
+			ru.loop[idx].our_seq = our_isn + 1u; /* +1 for the SYN below */
+		} else {
+			/* Slot was reset concurrently (USB reconfig); undo the connect. */
+			lck_mtx_unlock(ru.tx_lock);
+			sock_close(so);
+			return 1;
+		}
+		lck_mtx_unlock(ru.tx_lock);
+
+		printf("ROSEMARY USB: loopback TCP %u->62078 connected to 127.0.0.1:62078 isn=%u\n",
+		    peer_port, our_isn);
+		ru_loop_tx_segment(peer_port, our_isn, seg_seq + 1u, TH_SYN | TH_ACK, NULL, 0u);
+		return 1;
+	}
+
+	lck_mtx_lock(ru.tx_lock);
+	idx = ru_loop_find_locked(peer_port);
+	lck_mtx_unlock(ru.tx_lock);
+	if (idx < 0) {
+		if ((flags & TH_RST) == 0u) {
+			ru_loop_tx_segment(peer_port, seg_ack, seg_seq + (paylen != 0u ? paylen : 1u),
+			    TH_RST | TH_ACK, NULL, 0u);
+		}
+		return 1;
+	}
+
+	if ((flags & TH_RST) != 0u) {
+		lck_mtx_lock(ru.tx_lock);
+		ru_loop_close_locked(idx);
+		lck_mtx_unlock(ru.tx_lock);
+		printf("ROSEMARY USB: loopback TCP %u->62078 reset by usbmuxd\n", peer_port);
+		return 1;
+	}
+
+	if (paylen != 0u) {
+		socket_t so;
+		uint32_t expect_seq, our_seq, total_sent;
+		errno_t err = 0;
+
+		lck_mtx_lock(ru.tx_lock);
+		so = ru.loop[idx].so;
+		expect_seq = ru.loop[idx].peer_seq;
+		our_seq = ru.loop[idx].our_seq;
+		lck_mtx_unlock(ru.tx_lock);
+
+		if (so != NULL && seg_seq == expect_seq) {
+			total_sent = 0;
+			while (total_sent < paylen) {
+				struct msghdr msg;
+				struct iovec iov;
+				size_t sent = 0;
+				bzero(&msg, sizeof(msg));
+				iov.iov_base = (void *)(uintptr_t)(payload + total_sent);
+				iov.iov_len = paylen - total_sent;
+				msg.msg_iov = &iov;
+				msg.msg_iovlen = 1;
+				err = sock_send(so, &msg, 0, &sent);
+				if (err != 0 || sent == 0u) break;
+				total_sent += (uint32_t)sent;
+			}
+			if (err != 0 || total_sent != paylen) {
+				printf("ROSEMARY USB: loopback TCP %u->62078 sock_send err=%d sent=%u/%u\n",
+				    peer_port, err, total_sent, paylen);
+			}
+			expect_seq += paylen;
+			lck_mtx_lock(ru.tx_lock);
+			if (ru.loop[idx].valid && ru.loop[idx].peer_port == peer_port) {
+				ru.loop[idx].peer_seq = expect_seq;
+			}
+			lck_mtx_unlock(ru.tx_lock);
+		}
+		ru_loop_tx_segment(peer_port, our_seq, expect_seq, TH_ACK, NULL, 0u);
+	}
+
+	if ((flags & TH_FIN) != 0u) {
+		socket_t so;
+		uint32_t our_seq, new_peer_seq;
+
+		lck_mtx_lock(ru.tx_lock);
+		idx = ru_loop_find_locked(peer_port);
+		if (idx < 0) { lck_mtx_unlock(ru.tx_lock); return 1; }
+		ru.loop[idx].peer_seq++;
+		new_peer_seq = ru.loop[idx].peer_seq;
+		our_seq = ru.loop[idx].our_seq;
+		so = ru.loop[idx].so;
+		lck_mtx_unlock(ru.tx_lock);
+
+		if (so != NULL) sock_shutdown(so, SHUT_WR);
+		ru_loop_tx_segment(peer_port, our_seq, new_peer_seq, TH_ACK, NULL, 0u);
+		printf("ROSEMARY USB: loopback TCP %u->62078 got FIN, half-closing\n", peer_port);
+	}
+
+	return 1;
+}
+
+/* Drain one loopback socket (non-blocking) and forward whatever lockdownd
+ * sent back to usbmuxd, translating EOF into a FIN. Called every USB poll
+ * tick alongside ru_tx_poll()/ru_rx_poll(), so it never blocks the USB
+ * datapath for more than one MSG_DONTWAIT syscall per queued chunk. */
+static void ru_loop_poll_slot(uint32_t i)
+{
+	uint8_t buf[RU_LOOP_RX_CHUNK];
+	socket_t so;
+	uint16_t peer_port;
+	uint32_t our_seq, peer_seq;
+
+	lck_mtx_lock(ru.tx_lock);
+	if (!ru.loop[i].valid || ru.loop[i].so == NULL) {
+		lck_mtx_unlock(ru.tx_lock);
+		return;
+	}
+	so = ru.loop[i].so;
+	peer_port = ru.loop[i].peer_port;
+	our_seq = ru.loop[i].our_seq;
+	peer_seq = ru.loop[i].peer_seq;
+	lck_mtx_unlock(ru.tx_lock);
+
+	for (;;) {
+		struct msghdr msg;
+		struct iovec iov;
+		size_t recvd = 0;
+		errno_t err;
+
+		bzero(&msg, sizeof(msg));
+		iov.iov_base = buf;
+		iov.iov_len = sizeof(buf);
+		msg.msg_iov = &iov;
+		msg.msg_iovlen = 1;
+		err = sock_receive(so, &msg, MSG_DONTWAIT, &recvd);
+
+		if (err == EWOULDBLOCK || err == EAGAIN) return;
+
+		if (err != 0 || recvd == 0u) {
+			lck_mtx_lock(ru.tx_lock);
+			if (ru.loop[i].valid && ru.loop[i].peer_port == peer_port) {
+				our_seq = ru.loop[i].our_seq;
+				peer_seq = ru.loop[i].peer_seq;
+				ru.loop[i].our_seq = our_seq + 1u; /* FIN consumes one seq */
+				ru_loop_close_locked((int)i);
+			}
+			lck_mtx_unlock(ru.tx_lock);
+			ru_loop_tx_segment(peer_port, our_seq, peer_seq, TH_FIN | TH_ACK, NULL, 0u);
+			printf("ROSEMARY USB: loopback TCP %u->62078 lockdownd closed (err=%d); sent FIN\n",
+			    peer_port, err);
+			return;
+		}
+
+		ru_loop_tx_segment(peer_port, our_seq, peer_seq, TH_ACK, buf, (uint32_t)recvd);
+		our_seq += (uint32_t)recvd;
+		lck_mtx_lock(ru.tx_lock);
+		if (!ru.loop[i].valid || ru.loop[i].peer_port != peer_port) {
+			lck_mtx_unlock(ru.tx_lock);
+			return; /* slot reused/closed concurrently (reset path) */
+		}
+		ru.loop[i].our_seq = our_seq;
+		lck_mtx_unlock(ru.tx_lock);
+	}
+}
+
+static void ru_loop_poll(void)
+{
+	for (uint32_t i = 0; i < RU_LOOP_DEPTH; i++) ru_loop_poll_slot(i);
+}
+
+/* --- end lockdownd loopback bridge -------------------------------------- */
+

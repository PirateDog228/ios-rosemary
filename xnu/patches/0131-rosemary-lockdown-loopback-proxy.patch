 #define RU_MUX_HOST_IP            0xc6120001u /* 198.18.0.1: synthetic USB peer */
 #define RU_MUX_DEVICE_IP          0xc6120002u /* 198.18.0.2: local TCP services */
 
+/* lockdownd's socket_accept_callback classifies every accepted connection by
+ * the peer address accept() hands back: non-loopback is treated as "WiFi" and
+ * killed outright, and even a loopback peer must belong to the kernel itself
+ * (pid 0) or it is "unsafe". Relaying usbmuxd's TCP segments through rmx0
+ * (above) satisfies neither test, since lockdownd sees a plain remote peer on
+ * 198.18.0.1. For this one port, terminate usbmuxd's simplified TCP directly
+ * in software (no Ethernet/IP, just the embedded TCP segment) and bridge the
+ * payload to a real kernel-originated loopback socket to 127.0.0.1:62078 -
+ * exactly what AppleUSBMux does on a real iPhone, so lockdownd sees a genuine
+ * local/kernel peer. */
+#define RU_LOOP_PORT              62078u
+#define RU_LOOP_DEPTH             4u
+#define RU_LOOP_RX_CHUNK          1200u
+
 static const uint8_t ru_mux_host_mac[ETHER_ADDR_LEN] = { 0x02, 0x00, 0x5e, 0x77, 0xef, 0x01 };
 static const uint8_t ru_mux_device_mac[ETHER_ADDR_LEN] = { 0x02, 0x00, 0x5e, 0x77, 0xef, 0x02 };
 
@@ -250,6 +267,13 @@ static struct {
 		uint8_t valid;
 	} mux_tcp_map[RU_MUX_TCP_MAP_DEPTH];
 	uint32_t mux_tcp_map_next;
+	struct {
+		uint8_t valid;
+		uint16_t peer_port;   /* usbmuxd's synthetic client port */
+		uint32_t our_seq;     /* next seq we will use toward usbmuxd */
+		uint32_t peer_seq;    /* next seq we expect from usbmuxd (our ack) */
+		socket_t so;          /* real kernel socket to 127.0.0.1:62078 */
+	} loop[RU_LOOP_DEPTH];
 	struct {
 		uint16_t len;
 		uint8_t data[RU_MUX_TX_FRAME_MAX];

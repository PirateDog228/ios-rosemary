+/*
+ * What a job needs cleaned from the processor's cache, made when it is submitted and done by the worker thread
+ * just before the job runs, on another processor than the program's: the program's call of submit no longer
+ * waits for it. What the program wrote before it called is in the cache before the worker looks, and the
+ * buffers cannot go away meanwhile: freeBuffer waits for the last job a buffer was named in.
+ */
+struct mali_flush_item {
+	uintptr_t va;
+	size_t length;
+};
+
+struct mali_flush_list {
+	uint32_t count;
+	uint32_t allocated;
+	struct mali_flush_item items[1];
+};
+
 /*
  * The processor's cache cleaned for the GPU (which does not look into it), counted and timed
  * (sysctl kern.rosemary.mali_flush_*). Boot-arg malinoflush=1: not at all, to see what it costs.
@@ -63,6 +80,18 @@ mali_flush(uintptr_t va, size_t length)
 	rosemary_mali_account_flush(mach_absolute_time() - t0, length);
 }
 
+static void
+mali_flush_run(void * argument)
+{
+	struct mali_flush_list * list = (struct mali_flush_list *) argument;
+
+	for (uint32_t i = 0; i < list->count; i++) {
+		mali_flush(list->items[i].va, list->items[i].length);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");       /* the write buffers out before the GPU looks */
+	IOFreeData(list, list->allocated);
+}

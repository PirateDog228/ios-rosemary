+/* usbmuxd implements a small TCP-like state machine with zero-based counters:
+ * after a SYN-ACK it sends ACK=1 rather than acknowledging XNU's randomized
+ * server ISN. Normalize the server sequence space and translate peer ACKs back
+ * to XNU's real sequence space per TCP tuple. tx_lock is held by *_locked helpers. */
+static int ru_mux_tcp_map_find_locked(uint16_t local_port, uint16_t peer_port)
+{
+	for (uint32_t i = 0; i < RU_MUX_TCP_MAP_DEPTH; i++) {
+		if (ru.mux_tcp_map[i].valid &&
+		    ru.mux_tcp_map[i].local_port == local_port &&
+		    ru.mux_tcp_map[i].peer_port == peer_port) return (int)i;
+	}
+	return -1;
+}
+
+static void ru_mux_tcp_map_set_locked(uint16_t local_port, uint16_t peer_port,
+    uint32_t server_isn)
+{
+	int idx = ru_mux_tcp_map_find_locked(local_port, peer_port);
+	if (idx < 0) {
+		for (uint32_t i = 0; i < RU_MUX_TCP_MAP_DEPTH; i++) {
+			if (!ru.mux_tcp_map[i].valid) { idx = (int)i; break; }
+		}
+	}
+	if (idx < 0) {
+		idx = (int)(ru.mux_tcp_map_next++ % RU_MUX_TCP_MAP_DEPTH);
+	}
+	ru.mux_tcp_map[idx].valid = 0;
+	ru.mux_tcp_map[idx].local_port = local_port;
+	ru.mux_tcp_map[idx].peer_port = peer_port;
+	ru.mux_tcp_map[idx].server_isn = server_isn;
+	ru.mux_tcp_map[idx].valid = 1;
+	printf("ROSEMARY USB: TCP SEQMAP learn local=%u peer=%u server_isn=%u\n",
+	    local_port, peer_port, server_isn);
+}
+
+static void ru_mux_tcp_map_clear_locked(uint16_t local_port, uint16_t peer_port)
+{
+	int idx = ru_mux_tcp_map_find_locked(local_port, peer_port);
+	if (idx >= 0) ru.mux_tcp_map[idx].valid = 0;
+}
+
+static uint32_t ru_mux_tcp_map_get(uint16_t local_port, uint16_t peer_port,
+    int *found)
+{
+	uint32_t server_isn = 0;
+	int idx = -1;
+	*found = 0;
+	if (ru.tx_lock == NULL) return 0;
+	lck_mtx_lock(ru.tx_lock);
+	idx = ru_mux_tcp_map_find_locked(local_port, peer_port);
+	if (idx >= 0) {
+		server_isn = ru.mux_tcp_map[idx].server_isn;
+		*found = 1;
+	}
+	lck_mtx_unlock(ru.tx_lock);
+	return server_isn;
+}
+
+static void ru_mux_tcp_map_clear(uint16_t local_port, uint16_t peer_port)
+{
+	if (ru.tx_lock == NULL) return;
+	lck_mtx_lock(ru.tx_lock);
+	ru_mux_tcp_map_clear_locked(local_port, peer_port);
+	lck_mtx_unlock(ru.tx_lock);
+}

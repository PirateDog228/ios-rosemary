+
+	/* Learn XNU's randomized ISN at SYN-ACK time. The usbmuxd TCP shim
+	 * expects the device-side SYN-ACK sequence to be zero and sends ACK=1. */
+	if ((th.th_flags & (TH_SYN | TH_ACK)) == (TH_SYN | TH_ACK)) {
+		ru_mux_tcp_map_set_locked(local_port, peer_port, ntohl(th.th_seq));
+	}
+	map_idx = ru_mux_tcp_map_find_locked(local_port, peer_port);
+	if (map_idx >= 0) {
+		server_isn = ru.mux_tcp_map[map_idx].server_isn;
+		original_seq = ntohl(th.th_seq);
+		translated_seq = original_seq - server_isn;
+		th.th_seq = htonl(translated_seq);

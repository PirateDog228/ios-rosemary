+/*
+ * Use the creator's existing pages as the IOSurface backing store.
+ * Keep the same unaligned-range convention as Rosemary's selector-6
+ * wrapImage() implementation (0164), so wrapOffset and the returned base
+ * address have identical semantics.
+ *
+ * A few CoreAnimation image pages are read-only in the creating task. Try
+ * writable first, then read-only persistent, then read-only non-persistent,
+ * matching the fallback already used by wrapImage() (0165).
+ */
+static IOReturn
+sweet_surface_use_task_memory(SweetSurface *s, task_t task, uint64_t address, uint64_t size)
+{
+	static const struct {
+		IOOptionBits options;
+		bool readOnly;
+	} passes[3] = {
+		{ kIODirectionInOut | kIOMemoryPersistent, false },
+		{ kIODirectionOut | kIOMemoryPersistent, true },
+		{ kIODirectionOut, true },
+	};
+	IOReturn ret = kIOReturnVMError;
+
+	if (address == 0 || size == 0 || size > SWEET_SURFACE_MAX_ALLOC ||
+	    address > (~(uint64_t)0) - size) {
+		return kIOReturnBadArgument;
+	}
+	for (unsigned pass = 0; pass < 3; pass++) {
+		IOMemoryDescriptor *md = IOMemoryDescriptor::withAddressRange(address, size, passes[pass].options, task);
+		if (md == NULL) {
+			ret = kIOReturnNoMemory;
+			continue;
+		}
+		ret = md->prepare();
+		if (ret != kIOReturnSuccess) {
+			md->release();
+			continue;
+		}
+
+		s->memory = md;
+		s->wrapped = true;                 /* free() calls complete() */
+		s->wrapReadOnly = passes[pass].readOnly;
+		s->wrapOffset = (uint32_t)(address & (page_size - 1));
+		s->mapCache = kIOMapDefaultCache;
+		if (s->wrapReadOnly) {
+			s->mapCache |= kIOMapReadOnly;
+		}
+		return kIOReturnSuccess;
+	}
+	return ret == kIOReturnNoMemory ? kIOReturnNoMemory : kIOReturnVMError;
+}
 

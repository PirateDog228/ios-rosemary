+			printf("ROSEMARY USB: USBMUX malformed frame len=%u version=%u error=%d\n",
+			    len, wire_version, parsed);
+		}
+		return;
+	}
+
+	if (ru.mux_state == RU_MUX_WAIT_VERSION && frame.protocol == RUMUX_PROTO_VERSION) {
+		uint32_t requested, chosen;
+		uint8_t reply[20];
+		size_t reply_len;
+		if (frame.payload_len != 12u) {
+			printf("ROSEMARY USB: USBMUX VERSION payload len=%u (expected 12)\n",
+			    frame.payload_len);
+			return;
+		}
+		requested = rosemary_usbmux_get_be32(frame.payload);
+		if (requested != 1u && requested != 2u) {
+			printf("ROSEMARY USB: unsupported USBMUX version %u\n", requested);
+			return;
+		}
+		chosen = requested;
+		reply_len = rosemary_usbmux_build_version_reply(reply, sizeof(reply), chosen);
+		if (reply_len == 0u || !ru_tx_send(reply, (uint32_t)reply_len)) {
+			printf("ROSEMARY USB: failed to queue USBMUX VERSION reply\n");
+			return;
+		}
+		ru.mux_version = chosen;
+		ru.mux_state = (chosen >= 2u) ? RU_MUX_WAIT_SETUP : RU_MUX_ACTIVE;
+		printf("ROSEMARY USB: USBMUX VERSION %u accepted; %u-byte reply queued\n",
+		    chosen, (unsigned)reply_len);
+		return;
+	}
+
+	if (ru.mux_state == RU_MUX_WAIT_SETUP) {
+		if (frame.protocol != RUMUX_PROTO_SETUP || frame.payload_len != 1u || frame.payload[0] != 0x07u) {
+			printf("ROSEMARY USB: expected USBMUX v2 SETUP/07, got proto=%u payload=%u\n",
+			    frame.protocol, frame.payload_len);
+			return;
+		}
+		ru.mux_rx_seq = frame.tx_seq;
+		ru.mux_tx_seq = 0u;
+		ru.mux_state = RU_MUX_ACTIVE;
+		printf("ROSEMARY USB: USBMUX v2 SETUP accepted (tx_seq=%u rx_seq=%u); transport active\n",
+		    frame.tx_seq, frame.rx_seq);
+		return;
+	}
+
+	if (ru.mux_state == RU_MUX_ACTIVE && frame.protocol == RUMUX_PROTO_TCP) {
+		/* Deliberately do not fake TCP/lockdownd: this is the next transport
+		 * milestone after the real VERSION/SETUP handshake is verified. */
+		if (ru.rx_packets <= 8u) {
+			printf("ROSEMARY USB: USBMUX TCP frame received (%u payload bytes); TCP bridge pending\n",
+			    frame.payload_len);
+		}
+		return;
+	}
+
+	if (ru.rx_packets <= 8u) {
+		printf("ROSEMARY USB: ignored USBMUX proto=%u state=%u payload=%u\n",
+		    frame.protocol, ru.mux_state, frame.payload_len);
+	}
+}

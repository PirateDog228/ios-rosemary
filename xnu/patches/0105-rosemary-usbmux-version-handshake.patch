+/* Queue one bulk-IN transfer using the MTU3 QMU TX GPD. The host protocol
+ * engine and QMU share one TX buffer, so callers must not queue while busy. */
+static int ru_tx_send(const uint8_t *data, uint32_t len)
+{
+	struct ru_qmu_gpd *gpd = ru_tx_gpd();
+	uint64_t gpd_pa = ru.dma_pa + RU_GPD_TX_OFF;
+	uint64_t next_pa = gpd_pa + sizeof(*gpd);
+	uint64_t buffer_pa = ru.dma_pa + RU_TX_BUFFER_OFF;
+
+	if (!data || len == 0u || len > RU_TX_CAPACITY || ru.tx_active) {
+		ru.tx_errors++;
+		return 0;
+	}
+	if (!ru_qmu_stop(RU_TXQCSR1)) {
+		ru.tx_errors++;
+		printf("ROSEMARY USB: TX QMU stop timed out\n");
+		return 0;
+	}
+
+	bcopy(data, (void *)(ru.dma + RU_TX_BUFFER_OFF), len);
+	bzero(gpd, 2u * sizeof(*gpd));
+	gpd[0].next_gpd = (uint32_t)next_pa;
+	gpd[0].buffer = (uint32_t)buffer_pa;
+	gpd[0].dw3_info = len;
+	gpd[0].dw0_info = ru_gpd_upper(buffer_pa, next_pa);
+	gpd[1].next_gpd = (uint32_t)gpd_pa;
+
+	ru_dma_clean(RU_TX_BUFFER_OFF, len);
+	ru_dma_clean(RU_GPD_TX_OFF, 2u * sizeof(*gpd));
+	__asm__ volatile("dsb sy" ::: "memory");
+	/* HWO is published last so DMA never sees a partially built descriptor. */
+	gpd[0].dw0_info |= RU_QMU_GPD_IOC | RU_QMU_GPD_HWO;
+	ru_dma_clean(RU_GPD_TX_OFF, sizeof(*gpd));
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	ru_qmu_set_start(RU_TXQSAR1, RU_TXQHIAR1, gpd_pa);
+	ru_wr(ru.mac, RU_TX1CSR0,
+	    (ru_rd(ru.mac, RU_TX1CSR0) & ~0x7ffu) | RU_TX_DMAREQEN | RU_BULK_MPS);
+	__asm__ volatile("dsb sy" ::: "memory");
+	ru_wr(ru.mac, RU_TXQCSR1, RU_QMU_Q_START);
+	__asm__ volatile("dsb sy" ::: "memory");
+	ru.tx_active = 1;
+	ru.tx_len = len;
+	return 1;
+}
+
+static void ru_tx_poll(void)
+{
+	struct ru_qmu_gpd *gpd = ru_tx_gpd();
+	if (!ru.tx_active) return;
+	ru_dma_sync(RU_GPD_TX_OFF, 2u * sizeof(*gpd));
+	__asm__ volatile("dsb sy" ::: "memory");
+	if (gpd[0].dw0_info & RU_QMU_GPD_HWO) return;
+	if (!ru_qmu_stop(RU_TXQCSR1)) {
+		ru.tx_errors++;
+		printf("ROSEMARY USB: TX QMU completion stop timed out\n");
+		return;
+	}
+	ru.tx_active = 0;
+	ru.tx_packets++;
+	if (ru.tx_packets <= 8u) {
+		printf("ROSEMARY USB: bulk IN complete #%u len=%u\n", ru.tx_packets, ru.tx_len);
+	}
+}

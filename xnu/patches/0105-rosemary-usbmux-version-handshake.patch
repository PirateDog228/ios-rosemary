+static void ru_mux_rx_packet(const uint8_t *packet, uint32_t len)
+{
+	struct rosemary_usbmux_frame frame;
+	uint32_t wire_version = ru.mux_version;
+	int parsed = rosemary_usbmux_parse(packet, len, wire_version, &frame);
+
+	if (parsed != 0) {

diff --git a/bsd/dev/rosemary_usbmux_proto.h b/bsd/dev/rosemary_usbmux_proto.h
new file mode 100644
index 0000000..7383ac6
--- /dev/null
+++ b/bsd/dev/rosemary_usbmux_proto.h
@@ -0,0 +1,96 @@
+/*
+ * Small, allocation-free USBMUX framing helpers shared by XNU and the
+ * host-side unit test. Wire integers are big-endian, independent of CPU.
+ */
+#ifndef _BSD_DEV_ROSEMARY_USBMUX_PROTO_H_
+#define _BSD_DEV_ROSEMARY_USBMUX_PROTO_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#define RUMUX_PROTO_VERSION 0u
+#define RUMUX_PROTO_CONTROL 1u
+#define RUMUX_PROTO_SETUP   2u
+#define RUMUX_PROTO_TCP     6u
+#define RUMUX_MAGIC_V2      0xfeedfaceu
+#define RUMUX_VERSION_FRAME_SIZE 20u
+#define RUMUX_V1_HEADER_SIZE 8u
+#define RUMUX_V2_HEADER_SIZE 16u
+
+struct rosemary_usbmux_frame {
+	uint32_t protocol;
+	uint32_t total_len;
+	uint32_t magic;
+	uint16_t tx_seq;
+	uint16_t rx_seq;
+	const uint8_t *payload;
+	uint32_t payload_len;
+};
+
+static inline uint16_t rosemary_usbmux_get_be16(const uint8_t *p)
+{
+	return (uint16_t)(((uint16_t)p[0] << 8) | p[1]);
+}
+
+static inline uint32_t rosemary_usbmux_get_be32(const uint8_t *p)
+{
+	return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) |
+	    ((uint32_t)p[2] << 8) | (uint32_t)p[3];
+}
+
+static inline void rosemary_usbmux_put_be16(uint8_t *p, uint16_t v)
+{
+	p[0] = (uint8_t)(v >> 8);
+	p[1] = (uint8_t)v;
+}
+
+static inline void rosemary_usbmux_put_be32(uint8_t *p, uint32_t v)
+{
+	p[0] = (uint8_t)(v >> 24);
+	p[1] = (uint8_t)(v >> 16);
+	p[2] = (uint8_t)(v >> 8);
+	p[3] = (uint8_t)v;
+}
+
+/* version < 2 uses the 8-byte header; version 2 uses the 16-byte header. */
+static inline int rosemary_usbmux_parse(const uint8_t *buf, size_t len,
+    uint32_t version, struct rosemary_usbmux_frame *out)
+{
+	size_t header_len = (version >= 2u) ? RUMUX_V2_HEADER_SIZE : RUMUX_V1_HEADER_SIZE;
+	uint32_t total;
+
+	if (!buf || !out || len < header_len || len > 0xffffffffu) return -1;
+	total = rosemary_usbmux_get_be32(buf + 4);
+	if (total != len || total < header_len) return -2;
+	out->protocol = rosemary_usbmux_get_be32(buf);
+	out->total_len = total;
+	out->magic = 0;
+	out->tx_seq = 0;
+	out->rx_seq = 0;
+	if (version >= 2u) {
+		out->magic = rosemary_usbmux_get_be32(buf + 8);
+		if (out->magic != RUMUX_MAGIC_V2) return -3;
+		out->tx_seq = rosemary_usbmux_get_be16(buf + 12);
+		out->rx_seq = rosemary_usbmux_get_be16(buf + 14);
+	}
+	out->payload = buf + header_len;
+	out->payload_len = (uint32_t)(len - header_len);
+	return 0;
+}
+
+/* Reply to the host's initial VERSION request using the pre-negotiation
+ * 8-byte header. The caller queues the returned 20 bytes on bulk IN. */
+static inline size_t rosemary_usbmux_build_version_reply(uint8_t *out,
+    size_t capacity, uint32_t major)
+{
+	if (!out || capacity < RUMUX_VERSION_FRAME_SIZE || (major != 1u && major != 2u))
+		return 0;
+	rosemary_usbmux_put_be32(out + 0, RUMUX_PROTO_VERSION);
+	rosemary_usbmux_put_be32(out + 4, RUMUX_VERSION_FRAME_SIZE);
+	rosemary_usbmux_put_be32(out + 8, major);
+	rosemary_usbmux_put_be32(out + 12, 0u); /* minor */
+	rosemary_usbmux_put_be32(out + 16, 0u); /* padding */
+	return RUMUX_VERSION_FRAME_SIZE;
+}
+
+#endif /* _BSD_DEV_ROSEMARY_USBMUX_PROTO_H_ */
diff --git a/research/rosemary-usbmux/test-host.sh b/research/rosemary-usbmux/test-host.sh

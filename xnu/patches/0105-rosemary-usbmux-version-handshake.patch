index 0000000..3734d51
--- /dev/null
+++ b/research/rosemary-usbmux/test-host.sh
@@ -0,0 +1,9 @@
+#!/bin/sh
+set -eu
+ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
+CC=${CC:-cc}
+BIN=$(mktemp "${TMPDIR:-/tmp}/rosemary-usbmux-test.XXXXXX")
+trap 'rm -f "$BIN"' EXIT HUP INT TERM
+"$CC" -std=c99 -Wall -Wextra -Werror -pedantic \
+  "$ROOT/research/rosemary-usbmux/usbmux_proto_test.c" -o "$BIN"
+"$BIN"
diff --git a/research/rosemary-usbmux/usbmux_proto_test.c b/research/rosemary-usbmux/usbmux_proto_test.c
new file mode 100644
index 0000000..fc8458f
--- /dev/null
+++ b/research/rosemary-usbmux/usbmux_proto_test.c
@@ -0,0 +1,42 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "../../bsd/dev/rosemary_usbmux_proto.h"
+
+int main(void)
+{
+	/* usbmuxd initial MUX_PROTO_VERSION v2 request (legacy 8-byte header). */
+	static const uint8_t version_request[20] = {
+		0,0,0,0, 0,0,0,20, 0,0,0,2, 0,0,0,0, 0,0,0,0
+	};
+	/* MUX_PROTO_SETUP packet sent by usbmuxd after accepting version 2. */
+	static const uint8_t setup_v2[17] = {
+		0,0,0,2, 0,0,0,17, 0xfe,0xed,0xfa,0xce, 0,0, 0xff,0xff, 7
+	};
+	struct rosemary_usbmux_frame frame;
+	uint8_t reply[20];
+	size_t reply_len;
+
+	assert(rosemary_usbmux_parse(version_request, sizeof(version_request), 0, &frame) == 0);
+	assert(frame.protocol == RUMUX_PROTO_VERSION && frame.payload_len == 12);
+	assert(rosemary_usbmux_get_be32(frame.payload) == 2);
+	reply_len = rosemary_usbmux_build_version_reply(reply, sizeof(reply), 2);
+	assert(reply_len == 20);
+	assert(rosemary_usbmux_get_be32(reply) == 0);
+	assert(rosemary_usbmux_get_be32(reply + 4) == 20);
+	assert(rosemary_usbmux_get_be32(reply + 8) == 2);
+	assert(rosemary_usbmux_parse(reply, reply_len, 0, &frame) == 0);
+	assert(frame.payload_len == 12 && rosemary_usbmux_get_be32(frame.payload) == 2);
+
+	assert(rosemary_usbmux_parse(setup_v2, sizeof(setup_v2), 2, &frame) == 0);
+	assert(frame.protocol == RUMUX_PROTO_SETUP && frame.payload_len == 1);
+	assert(frame.payload[0] == 7 && frame.tx_seq == 0 && frame.rx_seq == 0xffff);
+
+	assert(rosemary_usbmux_parse(version_request, sizeof(version_request), 2, &frame) != 0);
+	assert(rosemary_usbmux_parse(version_request, sizeof(version_request) - 1, 0, &frame) != 0);
+	assert(rosemary_usbmux_build_version_reply(reply, 19, 2) == 0);
+	assert(rosemary_usbmux_build_version_reply(reply, sizeof(reply), 3) == 0);
+
+	puts("rosemary USBMUX host tests: PASS (v2 VERSION reply, v2 SETUP, malformed frames)");
+	return 0;
+}

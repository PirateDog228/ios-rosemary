+	/* 0141: EP0 IN multi-packet state. Every descriptor sent so far has fit
+	 * in one 64-byte packet, so the old code always finished a transfer
+	 * after exactly one; growing the config descriptor past 64 bytes (for a
+	 * second USB interface) needs real continuation. ep0_tx_buf holds a
+	 * private copy so the data survives across polling-loop iterations
+	 * after the caller that queued it has returned. */
+	uint8_t  ep0_tx_buf[256];
+	uint32_t ep0_tx_cursor;
+	uint32_t ep0_tx_remaining;
+	uint8_t  ep0_tx_zlp_pending;
 	uint32_t mux_version, mux_state;

 			continue;
 		}
 		if (state == RU_EP0_TX_END && !(ep0 & RU_EP0_TXPKTRDY) && !(ep0 & RU_EP0_FIFOFULL)) {
-			uint32_t csr = ru_rd(ru.mac, RU_EP0CSR) & RU_EP0_W1C_BITS;
-			ru_wr(ru.mac, RU_EP0CSR, csr | RU_EP0_DATAEND);
-			state = RU_EP0_SETUP;
+			ru_ep0_tx_continue(&state); /* 0141: was unconditional DATAEND - truncated >64-byte transfers */
 			continue;
 		}
 		ru_sleep_ms(RU_USB_POLL_MS);

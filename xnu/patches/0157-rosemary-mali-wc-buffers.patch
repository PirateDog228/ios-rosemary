+	bool wc;                                /* the programs see it write-combined: the cache never holds it */
+	uint32_t flushed_seed;                  /* a surface: its seed when its cache lines were last cleaned */
 };
 
+/*
+ * Boot-arg malibowc=1: buffers a program makes are mapped for it write-combined, as Linux's panfrost
+ * does, so that no cache holds them and nothing is cleaned around jobs. Without it they are cached and
+ * cleaned whole at every job that names them (which costs more than the jobs).
+ */
+static bool
+mali_bo_wc(void)
+{
+	static int wc = -1;
+
+	if (wc < 0) {
+		int v = 0;
+		wc = PE_parse_boot_argn("malibowc", &v, sizeof(v)) && v != 0;
+	}
+	return wc != 0;
+}

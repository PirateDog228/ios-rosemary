diff --git a/bsd/dev/rosemary_ufs.c b/bsd/dev/rosemary_ufs.c
--- a/bsd/dev/rosemary_ufs.c
+++ b/bsd/dev/rosemary_ufs.c
@@ -54,2 +54,9 @@ extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
 extern int get_preemption_level(void);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+extern int hz;
+/* The console ring lives in bsd/dev/sweet_ufs.c (also built for ROSEMARY, since
+ * ARM64_BOARD_CONFIG_SWEET is defined there); serial_console.c feeds it. */
+extern uint64_t sweet_log_position(void);
+extern uint32_t sweet_log_copy(uint64_t *pos, char *out, uint32_t max);
 
@@ -613,2 +620,97 @@ ufs_dump_head(void)
 
+/*
+ * Persistent console log, same on-disk format as sweet (kernel patch 0047):
+ * the last 4 MiB + 4 KiB of the partition hold a header block ("SWEETLOG",
+ * u32 version 1, u32 ring size, u64 total bytes, u64 flush sequence) and the
+ * 4 MiB ring, where console byte n sits at ring offset n % ring size. Read it
+ * from TWRP with tools/sweet-log-pull.sh. Needs ufsrw=1. Boot-args:
+ * sweetlog=0 disables it, ufslogsecs=<1..60> is the flush interval (default 10).
+ */
+#define ROSEMARY_LOG_SIZE       (4u << 20)
+#define ROSEMARY_LOG_BLOCKS     (1 + ROSEMARY_LOG_SIZE / UFS_BLOCK)
+#define ROSEMARY_LOG_SECS       10u
+
+static int rosemary_log_chan;
+static uint32_t rosemary_log_secs = ROSEMARY_LOG_SECS;
+
+struct rosemary_log_header {
+	char magic[8];
+	uint32_t version, size;
+	uint64_t total, seq;
+};
+
+static void
+rosemary_log_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t base = su.first_block + su.nblocks - ROSEMARY_LOG_BLOCKS;
+	uint64_t flushed = 0, seq = 0;
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+
+	printf("ROSEMARY LOG: console log to the last %u KiB of the partition (block 0x%llx)\n",
+	    ROSEMARY_LOG_BLOCKS * UFS_BLOCK >> 10, base);
+	for (;;) {
+		(void)tsleep(&rosemary_log_chan, PZERO, "rosemarylog", hz * (int)rosemary_log_secs);
+		uint64_t total = sweet_log_position();
+		if (total == flushed) {
+			continue;
+		}
+		/* Start at the 4 KiB boundary at or below the first unflushed byte so the
+		 * partial block is rewritten whole; never older than the ring holds. */
+		uint64_t p = flushed & ~(uint64_t)(UFS_BLOCK - 1);
+		if (total - p > ROSEMARY_LOG_SIZE) {
+			p = (total - ROSEMARY_LOG_SIZE + UFS_BLOCK - 1) & ~(uint64_t)(UFS_BLOCK - 1);
+		}
+		int error = 0;
+
+		lck_mtx_lock(&rosemary_ufs_lock);
+		while (p < total && !error) {
+			uint32_t off = (uint32_t)(p % ROSEMARY_LOG_SIZE);
+			uint64_t want = MIN(total - p, (uint64_t)MIN(ROSEMARY_LOG_SIZE - off, BOUNCE_SIZE));
+			uint32_t nblk = (uint32_t)((want + UFS_BLOCK - 1) / UFS_BLOCK);
+			uint64_t from = p;
+			bzero(bounce, (size_t)nblk * UFS_BLOCK);
+			(void)sweet_log_copy(&from, (char *)bounce, (uint32_t)want);
+			error = ufs_write_blocks(base + 1 + off / UFS_BLOCK, nblk);
+			p += (uint64_t)nblk * UFS_BLOCK;
+		}
+		if (!error) {
+			struct rosemary_log_header h = {
+				.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
+				.version = 1, .size = ROSEMARY_LOG_SIZE, .total = total, .seq = ++seq,
+			};
+			bzero(bounce, UFS_BLOCK);
+			memcpy(bounce, &h, sizeof(h));
+			error = ufs_write_blocks(base, 1);
+		}
+		if (!error) {
+			error = ufs_sync_cache();
+		}
+		lck_mtx_unlock(&rosemary_ufs_lock);
+		if (error) {
+			printf("ROSEMARY LOG: write failed (%d), stopping\n", error);
+			return;
+		}
+		flushed = total;
+	}
+}
+
+static void
+rosemary_log_start(void)
+{
+	uint32_t on = 1;
+	thread_t thread;
+
+	PE_parse_boot_argn("sweetlog", &on, sizeof(on));
+	if (!on || !su.writable || su.nblocks < 2 * ROSEMARY_LOG_BLOCKS) {
+		return;
+	}
+	PE_parse_boot_argn("ufslogsecs", &rosemary_log_secs, sizeof(rosemary_log_secs));
+	if (rosemary_log_secs == 0 || rosemary_log_secs > 60) {
+		rosemary_log_secs = ROSEMARY_LOG_SECS;
+	}
+	if (kernel_thread_start(rosemary_log_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
 static int
@@ -692,2 +794,3 @@ rosemary_ufs_init(void)
 	    su.writable ? "read-write" : "read-only", su.dma_pa);
+	rosemary_log_start();
 	uint32_t pause = 0;

+	 * 512, got 584") and usbmuxd drops both. Do not rely on the controller's
+	 * ZLP: move the last payload byte of such a plain-ACK data segment into a
+	 * second TCP segment, so no frame is exactly 512 (or 1024, ...) bytes. */
+	if ((total_len % RU_BULK_MPS) == 0u && tcp_segment[13] == TH_ACK &&
+	    ru.txq_count + 1u < RU_MUX_TXQ_DEPTH) {

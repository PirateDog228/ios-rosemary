+/* 0122: recompute the TCP checksum of a device->host segment (10.x pseudo header). */
+static void ru_mux_tcp_fix_checksum(uint8_t *seg, uint32_t len)
+{
+	uint8_t pseudo[12];
+	uint32_t src_ip = htonl(RU_MUX_DEVICE_IP);
+	uint32_t dst_ip = htonl(RU_MUX_HOST_IP);
+	uint32_t sum;
+	uint16_t cs;
+	bcopy(&src_ip, pseudo, 4);
+	bcopy(&dst_ip, pseudo + 4, 4);
+	pseudo[8] = 0;
+	pseudo[9] = IPPROTO_TCP;
+	pseudo[10] = (uint8_t)(len >> 8);
+	pseudo[11] = (uint8_t)len;
+	seg[16] = 0;
+	seg[17] = 0;
+	sum = ru_checksum_add(0, pseudo, sizeof(pseudo));
+	sum = ru_checksum_add(sum, seg, len);
+	cs = ru_checksum_finish(sum);
+	seg[16] = (uint8_t)(cs >> 8);
+	seg[17] = (uint8_t)cs;
+}

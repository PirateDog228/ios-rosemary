+		if (tcp_len >= hl + 2u) {
+			uint8_t *out2;
+			uint32_t paylen = tcp_len - hl;
+			uint32_t seq2 = ((uint32_t)tcp_segment[4] << 24) | ((uint32_t)tcp_segment[5] << 16) |
+			    ((uint32_t)tcp_segment[6] << 8) | tcp_segment[7];
+			uint32_t tcp_len2 = hl + 1u;
+			idx2 = (idx + 1u) % RU_MUX_TXQ_DEPTH;
+			out2 = ru.txq[idx2].data;
+			bcopy(out, out2, header_len + hl);
+			out2[header_len + hl] = tcp_segment[tcp_len - 1u];
+			seq2 += paylen - 1u;
+			out2[header_len + 4] = (uint8_t)(seq2 >> 24);
+			out2[header_len + 5] = (uint8_t)(seq2 >> 16);
+			out2[header_len + 6] = (uint8_t)(seq2 >> 8);
+			out2[header_len + 7] = (uint8_t)seq2;
+			split2 = header_len + tcp_len2;
+			rosemary_usbmux_put_be32(out2 + 4, split2);
+			if (ru.mux_version >= 2u) rosemary_usbmux_put_be16(out2 + 12, ru.mux_tx_seq++);
+			ru_mux_tcp_fix_checksum(out2 + header_len, tcp_len2);
+			tcp_len -= 1u;
+			total_len -= 1u;
+			rosemary_usbmux_put_be32(out + 4, total_len);
+			ru_mux_tcp_fix_checksum(tcp_segment, tcp_len);
+			printf("ROSEMARY USB: TCP OUT split frame (was %u bytes) into %u + %u\n",
+			    total_len + 1u, total_len, split2);

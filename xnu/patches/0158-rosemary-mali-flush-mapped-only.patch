 static uint64_t rm_job_ns, rm_job_max_ns, rm_flush_ns, rm_flush_bytes, rm_flush_calls;
+static uint64_t rm_skip_bytes;                  /* cache cleanings not needed: bytes of buffers no program ever mapped */

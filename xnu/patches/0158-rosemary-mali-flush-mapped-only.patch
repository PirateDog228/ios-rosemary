 SYSCTL_QUAD(_kern_rosemary, OID_AUTO, mali_flush_ns, CTLFLAG_RD | CTLFLAG_LOCKED, &rm_flush_ns, "total time cleaning caches, ns");
 SYSCTL_QUAD(_kern_rosemary, OID_AUTO, mali_flush_bytes, CTLFLAG_RD | CTLFLAG_LOCKED, &rm_flush_bytes, "bytes cleaned");
 SYSCTL_QUAD(_kern_rosemary, OID_AUTO, mali_flush_calls, CTLFLAG_RD | CTLFLAG_LOCKED, &rm_flush_calls, "cache cleanings");
+SYSCTL_QUAD(_kern_rosemary, OID_AUTO, mali_skip_bytes, CTLFLAG_RD | CTLFLAG_LOCKED, &rm_skip_bytes, "bytes not cleaned: never mapped by a program");
 SYSCTL_UINT(_kern_rosemary, OID_AUTO, mali_spin, CTLFLAG_RD | CTLFLAG_LOCKED, &rm_spin, 0, "polling instead of sleeping");
 
+void
+rosemary_mali_account_skip(uint64_t bytes)
+{
+	rm_skip_bytes += bytes;
+}

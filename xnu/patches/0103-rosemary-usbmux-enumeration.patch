+#define RU_ACR5_RG_HSTX_SRCTRL    (7u << 12)
+#define RU_ACR5_RG_HS_100U_U3_EN  RU_BIT(11)
+#define RU_ACR6_RG_PHY_REV6       (3u << 30)

+/*
+ * ROSEMARY (Redmi Note 10S / MT6785) USB device-mode enumeration bring-up.
+ *
+ * This is a first kernel-side milestone, not a complete USBMUX service:
+ *   - initializes the verified MTU3 USB2 peripheral path;
+ *   - enumerates with Apple VID/PID and a synthetic project UDID;
+ *   - exposes the Apple USBMUX interface and keeps its OUT endpoint drained;
+ *   - leaves IN reads pending/NAKed until a later patch connects USBMUX to
+ *     lockdownd. idevice_id may therefore list this device, while ideviceinfo,
+ *     pairing and backups are not expected to work yet.
+ *
+ * Enable explicitly with the boot-arg rosemaryusb=1. This avoids taking over
+ * the USB peripheral while the user is booting a diagnostic/recovery image.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET) && defined(ROSEMARY)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+

+#define RU_ACR6_RG_OTG_VBUSCMP_EN RU_BIT(20)
+#define RU_ACR6_RG_DISCTH         (0xfu << 4)
+#define RU_ACR6_RG_SQTH           0xfu
+#define RU_ACR4_GPIO_CTRL_MASK    (RU_BIT(9) | RU_BIT(8))
+#define RU_FREQ_RG_FREQDET_EN     RU_BIT(24)
+#define RU_FREQ_RG_CYCLECNT       0x00ffffffu
+#define RU_FMMON_RG_FRCK_EN       RU_BIT(8)
+#define RU_FMMON_USB_FM_VALID     RU_BIT(0)
+
+#define RU_MAC_SOFT_CONN          RU_BIT(6)
+#define RU_MAC_HS_ENABLE          RU_BIT(5)
+#define RU_MAC_SUSPENDM_ENABLE    RU_BIT(0)
+#define RU_MAC_LPM_HRWE           RU_BIT(10)
+#define RU_MAC_VBUS_FRC_EN        RU_BIT(0)
+#define RU_MAC_VBUS_ON            RU_BIT(1)
+#define RU_MAC_FRC_VBUS_BITS      (RU_MAC_VBUS_FRC_EN | RU_MAC_VBUS_ON)
+#define RU_EP0_SENDSTALL          RU_BIT(25)
+#define RU_EP0_FIFOFULL           RU_BIT(23)
+#define RU_EP0_SENTSTALL          RU_BIT(22)
+#define RU_EP0_DPHTX              RU_BIT(20)
+#define RU_EP0_DATAEND            RU_BIT(19)
+#define RU_EP0_TXPKTRDY           RU_BIT(18)
+#define RU_EP0_SETUPPKTRDY        RU_BIT(17)
+#define RU_EP0_RXPKTRDY           RU_BIT(16)
+#define RU_EP0_MAXPKTSZ_MASK      0x3ffu
+#define RU_EP0_W1C_BITS           (~(RU_EP0_RXPKTRDY | RU_EP0_SETUPPKTRDY | RU_EP0_SENTSTALL))
+#define RU_USB_RESET_INTR          RU_BIT(2)
+#define RU_DEVICE_ADDR_MASK       (0x7fu << 24)
+#define RU_DEVICE_ADDR(n)         (((uint32_t)(n) & 0x7fu) << 24)
+
+#define RU_QMU_Q_ACTIVE           RU_BIT(15)
+#define RU_QMU_Q_STOP             RU_BIT(2)
+#define RU_QMU_Q_START            RU_BIT(0)
+#define RU_QMU_GPD_HWO            RU_BIT(0)
+#define RU_QMU_GPD_IOC            RU_BIT(7)
+#define RU_TX_DMAREQEN            RU_BIT(29)
+#define RU_RX_DMAREQEN            RU_BIT(29)
+#define RU_BULK_MPS               512u
+#define RU_RX_CAPACITY            49152u
+#define RU_DMA_SIZE               0x20000u
+#define RU_GPD_TX_OFF             0x0000u
+#define RU_GPD_RX_OFF             0x0040u
+#define RU_RX_BUFFER_OFF          0x1000u
+#define RU_TX_BUFFER_OFF          0x10000u
+#define RU_USB_POLL_MS            1u
+
+#define RU_USB_VID                0x05acu
+#define RU_USB_PID                0x12a8u /* usbmuxd-supported Apple PID range */
+
+struct ru_qmu_gpd {
+	uint32_t dw0_info;
+	uint32_t next_gpd;
+	uint32_t buffer;
+	uint32_t dw3_info;
+} __attribute__((packed));
+
+enum ru_ep0_state { RU_EP0_SETUP, RU_EP0_TX_END };
+
+static struct {
+	vm_offset_t mac, ippc, u2;
+	vm_offset_t dma;
+	uint64_t dma_pa;
+	uint32_t configuration, seen_configuration;
+	uint32_t rx_packets, rx_errors;
+	uint32_t rx_hardware_version;
+	int rx_gen2, rx_active;
+	int wait_channel;
+} ru;
+
+static uint32_t ru_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void ru_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static uint64_t ru_counter(void)
+{
+	uint64_t v;
+	__asm__ volatile("isb; mrs %0, cntpct_el0" : "=r"(v));
+	return v;
+}
+
+static uint64_t ru_counter_freq(void)
+{
+	uint64_t v;
+	__asm__ volatile("mrs %0, cntfrq_el0" : "=r"(v));
+	return v;
+}
+
+static void ru_delay_us(uint32_t us)
+{
+	uint64_t hz = ru_counter_freq();
+	uint64_t start = ru_counter();
+	uint64_t ticks = (hz * us) / 1000000ULL;
+	if (ticks == 0) ticks = 1;
+	while ((ru_counter() - start) < ticks) {
+		__asm__ volatile("yield");
+	}
+}
+
+static void ru_sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&ru.wait_channel, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void ru_dma_clean(uint32_t off, uint32_t len)
+{
+	clean_dcache64((addr64_t)(ru.dma_pa + off), len, TRUE);
+}
+
+static void ru_dma_sync(uint32_t off, uint32_t len)
+{
+	flush_dcache64((addr64_t)(ru.dma_pa + off), len, TRUE);
+}
+
+static uint32_t ru_u2_phy_init(void)
+{
+	uint32_t tmp, fm_out, cal, fm_valid = 0;
+	uint64_t start, timeout_ticks;
+
+	tmp = ru_rd(ru.u2, RU_U2_DTM0);
+	tmp &= ~(RU_DTM0_FORCE_UART_EN | RU_DTM0_FORCE_SUSPENDM);
+	tmp |= (1u << 4);
+	ru_wr(ru.u2, RU_U2_DTM0, tmp);
+	tmp = ru_rd(ru.u2, RU_U2_DTM1) & ~RU_DTM1_RG_UART_EN;
+	ru_wr(ru.u2, RU_U2_DTM1, tmp);
+	tmp = ru_rd(ru.u2, RU_U2_ACR0) | RU_ACR0_RG_USB20_INTR_EN;
+	ru_wr(ru.u2, RU_U2_ACR0, tmp);
+	tmp = ru_rd(ru.u2, RU_U2_ACR5) & ~RU_ACR5_RG_HS_100U_U3_EN;
+	ru_wr(ru.u2, RU_U2_ACR5, tmp);
+	tmp = ru_rd(ru.u2, RU_U2_ACR4) & ~RU_ACR4_GPIO_CTRL_MASK;
+	ru_wr(ru.u2, RU_U2_ACR4, tmp);
+	tmp = ru_rd(ru.u2, RU_U2_ACR6) & ~(RU_ACR6_RG_BC11_SW_EN | RU_ACR6_RG_SQTH);
+	tmp |= 2u;
+	ru_wr(ru.u2, RU_U2_ACR6, tmp);
+
+	tmp = ru_rd(ru.u2, RU_U2_DTM0) | RU_DTM0_FORCE_SUSPENDM;
+	ru_wr(ru.u2, RU_U2_DTM0, tmp);
+	tmp = ru_rd(ru.u2, RU_U2_DTM0) & ~RU_DTM0_RG_SUSPENDM;
+	ru_wr(ru.u2, RU_U2_DTM0, tmp);
+	tmp = ru_rd(ru.u2, RU_U2_DTM0) | RU_DTM0_RG_SUSPENDM;
+	ru_wr(ru.u2, RU_U2_DTM0, tmp);
+	ru_delay_us(30);
+	tmp = ru_rd(ru.u2, RU_U2_DTM0) & ~RU_DTM0_FORCE_SUSPENDM;
+	ru_wr(ru.u2, RU_U2_DTM0, tmp);
+	tmp = ru_rd(ru.u2, RU_U2_DTM0) & ~RU_DTM0_RG_SUSPENDM;
+	ru_wr(ru.u2, RU_U2_DTM0, tmp);
+	tmp = ru_rd(ru.u2, RU_U2_DTM0) & ~RU_DTM0_FORCE_UART_EN;
+	ru_wr(ru.u2, RU_U2_DTM0, tmp);
+	tmp = ru_rd(ru.u2, RU_U2_DTM1) & ~RU_DTM1_RG_UART_EN;
+	ru_wr(ru.u2, RU_U2_DTM1, tmp);
+	tmp = ru_rd(ru.u2, RU_U2_ACR4) & ~RU_ACR4_GPIO_CTRL_MASK;
+	ru_wr(ru.u2, RU_U2_ACR4, tmp);
+	tmp = ru_rd(ru.u2, RU_U2_DTM0) & ~RU_DTM0_FORCE_SUSPENDM;
+	ru_wr(ru.u2, RU_U2_DTM0, tmp);
+	tmp = ru_rd(ru.u2, RU_U2_DTM0) & ~(RU_DTM0_RG_XCVRSEL | RU_DTM0_RG_DATAIN | RU_DTM0_PART_MASK);
+	ru_wr(ru.u2, RU_U2_DTM0, tmp);
+	tmp = ru_rd(ru.u2, RU_U2_ACR6) & ~RU_ACR6_RG_BC11_SW_EN;
+	ru_wr(ru.u2, RU_U2_ACR6, tmp);
+	tmp = ru_rd(ru.u2, RU_U2_ACR6) | RU_ACR6_RG_OTG_VBUSCMP_EN;
+	ru_wr(ru.u2, RU_U2_ACR6, tmp);
+	tmp = ru_rd(ru.u2, RU_U2_DTM1) | RU_DTM1_RG_VBUSVALID | RU_DTM1_RG_AVALID;
+	tmp &= ~RU_DTM1_RG_SESSEND;
+	ru_wr(ru.u2, RU_U2_DTM1, tmp);
+	tmp = ru_rd(ru.u2, RU_U2_ACR6) & ~RU_ACR6_RG_PHY_REV6;
+	tmp |= (1u << 30);
+	ru_wr(ru.u2, RU_U2_ACR6, tmp);
+	ru_delay_us(800);
+
+	tmp = ru_rd(ru.u2, RU_U2_ACR5) | RU_ACR5_RG_HSTX_SRCAL_EN;
+	ru_wr(ru.u2, RU_U2_ACR5, tmp);
+	ru_delay_us(1);
+	tmp = ru_rd(ru.u2, RU_U2_FREQ + 0x10u) | RU_FMMON_RG_FRCK_EN;
+	ru_wr(ru.u2, RU_U2_FREQ + 0x10u, tmp);
+	tmp = ru_rd(ru.u2, RU_U2_FREQ) & ~(RU_FREQ_RG_CYCLECNT | (3u << 26));
+	tmp |= 1024u;
+	ru_wr(ru.u2, RU_U2_FREQ, tmp);
+	tmp = ru_rd(ru.u2, RU_U2_FREQ) | RU_FREQ_RG_FREQDET_EN;
+	ru_wr(ru.u2, RU_U2_FREQ, tmp);
+	start = ru_counter();
+	timeout_ticks = ru_counter_freq() / 5000ULL;
+	while ((ru_counter() - start) < timeout_ticks) {
+		if (ru_rd(ru.u2, RU_U2_FREQ + 0x10u) & RU_FMMON_USB_FM_VALID) {
+			fm_valid = 1;
+			break;
+		}
+		ru_delay_us(10);
+	}
+	fm_out = ru_rd(ru.u2, RU_U2_FREQ + 0x0cu);
+	tmp = ru_rd(ru.u2, RU_U2_FREQ) & ~RU_FREQ_RG_FREQDET_EN;
+	ru_wr(ru.u2, RU_U2_FREQ, tmp);
+	tmp = ru_rd(ru.u2, RU_U2_FREQ + 0x10u) & ~RU_FMMON_RG_FRCK_EN;
+	ru_wr(ru.u2, RU_U2_FREQ + 0x10u, tmp);
+	if (fm_out) {
+		tmp = (26u * 28u * 1024u) / fm_out;
+		cal = (tmp + 500u) / 1000u;
+	} else {
+		cal = 4u;
+	}
+	cal &= 7u;
+	tmp = ru_rd(ru.u2, RU_U2_ACR5) & ~RU_ACR5_RG_HSTX_SRCTRL;
+	tmp |= cal << 12;
+	ru_wr(ru.u2, RU_U2_ACR5, tmp);
+	tmp = ru_rd(ru.u2, RU_U2_ACR5) & ~RU_ACR5_RG_HSTX_SRCAL_EN;
+	ru_wr(ru.u2, RU_U2_ACR5, tmp);
+	tmp = ru_rd(ru.u2, RU_U2_ACR1) & ~(RU_ACR1_RG_VRT_SEL | RU_ACR1_RG_TERM_SEL);
+	tmp |= (6u << 12) | (6u << 8);
+	ru_wr(ru.u2, RU_U2_ACR1, tmp);
+	tmp = ru_rd(ru.u2, RU_U2_ACR6) & ~(RU_ACR6_RG_PHY_REV6 | RU_ACR6_RG_DISCTH);
+	tmp |= (1u << 30) | (7u << 4);
+	ru_wr(ru.u2, RU_U2_ACR6, tmp);
+	printf("ROSEMARY USB: U2 PHY calibration valid=%u FM=%u SR=%u\n", fm_valid, fm_out, cal);
+	return fm_valid;
+}

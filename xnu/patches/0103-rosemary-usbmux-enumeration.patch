+static void ru_fifo_read(uint8_t *dst, uint32_t len)
+{
+	uint32_t i = 0;
+	while (len - i >= 4u) {
+		uint32_t v = ru_rd(ru.mac, RU_FIFO0);
+		dst[i++] = (uint8_t)v;
+		dst[i++] = (uint8_t)(v >> 8);
+		dst[i++] = (uint8_t)(v >> 16);
+		dst[i++] = (uint8_t)(v >> 24);
+	}
+	if (len > i) {
+		uint32_t v = ru_rd(ru.mac, RU_FIFO0);
+		while (i < len) {
+			dst[i] = (uint8_t)(v >> (8u * (i & 3u)));
+			i++;
+		}
+	}
+}
+
+static void ru_fifo_write(const uint8_t *src, uint32_t len)
+{
+	uint32_t i = 0;
+	while (len - i >= 4u) {
+		uint32_t v = (uint32_t)src[i] | ((uint32_t)src[i + 1] << 8) |
+		    ((uint32_t)src[i + 2] << 16) | ((uint32_t)src[i + 3] << 24);
+		ru_wr(ru.mac, RU_FIFO0, v);
+		i += 4u;
+	}
+	if (len - i >= 2u) {
+		uint32_t v = (uint32_t)src[i] | ((uint32_t)src[i + 1] << 8);
+		ru_wr(ru.mac, RU_FIFO0, v);
+		i += 2u;
+	}
+	if (len > i) {
+		*(volatile uint8_t *)(ru.mac + RU_FIFO0) = src[i];
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}

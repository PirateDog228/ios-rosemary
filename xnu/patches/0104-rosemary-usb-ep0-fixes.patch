+	ru_wr(ru.mac, RU_USB2_COMMON_INTR, 0xffffffffu);
+	ru_wr(ru.mac, RU_DEV_LINK_INTR, 0xffffffffu);
+	ru_ep0_setup_hw();
+	ru_dump("before-attach");
 	/* Attach only after descriptors and EP0 handling are ready. */
 	ru_wr(ru.mac, RU_POWER_MGMT, ru_rd(ru.mac, RU_POWER_MGMT) | RU_MAC_SOFT_CONN | RU_MAC_SUSPENDM_ENABLE);
+	ru_dump("attached");
 	printf("ROSEMARY USB: attached as Apple iPhone (05ac:12a8), synthetic UDID 00008110-AABBCCDDEEFF1234\n");
 }
 

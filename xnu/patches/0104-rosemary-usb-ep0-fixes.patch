@@ -285,6 +312,10 @@
 	tmp |= (1u << 30);
 	ru_wr(ru.u2, RU_U2_ACR6, tmp);
 	ru_delay_us(800);
+	/* Device role: force IDDIG=1 (B-device) as the vendor driver does through
+	 * phy_set_mode(PHY_MODE_USB_DEVICE). Without it the PHY follows the real ID pin. */
+	tmp = ru_rd(ru.u2, RU_U2_DTM1) | RU_DTM1_FORCE_IDDIG | RU_DTM1_RG_IDDIG;
+	ru_wr(ru.u2, RU_U2_DTM1, tmp);
 
 	tmp = ru_rd(ru.u2, RU_U2_ACR5) | RU_ACR5_RG_HSTX_SRCAL_EN;
 	ru_wr(ru.u2, RU_U2_ACR5, tmp);
@@ -384,8 +415,11 @@
 		i += 4u;
 	}
 	if (len - i >= 2u) {
-		uint32_t v = (uint32_t)src[i] | ((uint32_t)src[i + 1] << 8);
-		ru_wr(ru.mac, RU_FIFO0, v);
+		/* A 32-bit store would push four bytes into the FIFO; the MTU3 needs a
+		 * 16-bit access for a two-byte tail (vendor ep0_write_fifo: writew). */
+		uint16_t v = (uint16_t)((uint32_t)src[i] | ((uint32_t)src[i + 1] << 8));
+		__asm__ volatile("dmb oshst" ::: "memory");
+		*(volatile uint16_t *)(ru.mac + RU_FIFO0) = v;
 		i += 2u;
 	}
 	if (len > i) {
@@ -496,6 +530,12 @@
 	uint8_t config_desc[32];

+#define RU_DTM0_PART_MASK         (RU_BIT(23) | RU_BIT(21) | RU_BIT(20) | RU_BIT(19) | RU_BIT(18) | \
+	RU_BIT(17) | RU_BIT(7) | RU_BIT(6) | RU_BIT(2))
 #define RU_DTM1_RG_UART_EN        RU_BIT(16)
+#define RU_DTM1_FORCE_IDDIG       RU_BIT(9)
+#define RU_DTM1_RG_IDDIG          RU_BIT(1)
 #define RU_DTM1_RG_VBUSVALID      RU_BIT(5)
 #define RU_DTM1_RG_SESSEND        RU_BIT(4)
 #define RU_DTM1_RG_AVALID         RU_BIT(2)
@@ -134,6 +151,13 @@
 #define RU_EP0_W1C_BITS           (~(RU_EP0_RXPKTRDY | RU_EP0_SETUPPKTRDY | RU_EP0_SENTSTALL))
 #define RU_USB_RESET_INTR          RU_BIT(2)
 #define RU_DEVICE_ADDR_MASK       (0x7fu << 24)
+#define RU_DEV_SPEED(v)           ((v) & 7u)
+#define RU_LINK_SPEED_CHG         RU_BIT(0)
+#define RU_EP0ISR                 RU_BIT(0)
+#define RU_SETUPENDISR            RU_BIT(16)
+#define RU_LPM_BESL_STALL         RU_BIT(14)
+#define RU_LPM_BESLD_STALL        RU_BIT(13)
+/* The U3 MAC block (0x1400..) is deliberately not touched: it is not needed for a USB2 device. */
 #define RU_DEVICE_ADDR(n)         (((uint32_t)(n) & 0x7fu) << 24)
 

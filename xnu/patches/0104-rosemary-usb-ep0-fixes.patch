+static void ru_dump(const char *tag)
+{
+	printf("ROSEMARY USB[%s]: IPPC sts1=%08x sts2=%08x otg=%08x pdn=%08x/%08x/%08x u2port=%08x\n", tag,
+	    ru_rd(ru.ippc, RU_IPPC_STS1), ru_rd(ru.ippc, RU_IPPC_STS2), ru_rd(ru.ippc, RU_IPPC_OTG_STS),
+	    ru_rd(ru.ippc, RU_IPPC_IP_PDN), ru_rd(ru.ippc, RU_IPPC_HOST_PDN),
+	    ru_rd(ru.ippc, RU_IPPC_DEV_PDN), ru_rd(ru.ippc, RU_IPPC_U2_PORT));
+	printf("ROSEMARY USB[%s]: MAC lv1=%08x episr=%08x ep0csr=%08x pm=%08x devctl=%08x devconf=%08x misc=%08x\n", tag,
+	    ru_rd(ru.mac, RU_LV1ISR), ru_rd(ru.mac, RU_EPISR), ru_rd(ru.mac, RU_EP0CSR),
+	    ru_rd(ru.mac, RU_POWER_MGMT), ru_rd(ru.mac, RU_DEVICE_CTRL), ru_rd(ru.mac, RU_DEVICE_CONF),
+	    ru_rd(ru.mac, RU_MISC_CTRL));
+	printf("ROSEMARY USB[%s]: common=%08x link=%08x PHY acr0=%08x acr1=%08x acr5=%08x acr6=%08x dtm0=%08x dtm1=%08x\n", tag,
+	    ru_rd(ru.mac, RU_USB2_COMMON_INTR), ru_rd(ru.mac, RU_DEV_LINK_INTR),
+	    ru_rd(ru.u2, RU_U2_ACR0), ru_rd(ru.u2, RU_U2_ACR1), ru_rd(ru.u2, RU_U2_ACR5),
+	    ru_rd(ru.u2, RU_U2_ACR6), ru_rd(ru.u2, RU_U2_DTM0), ru_rd(ru.u2, RU_U2_DTM1));
+}
+
+/* Vendor mtu3_ep0_setup(): MAXPKTSZ plus enabling the EP0 / SETUP-end status. */
+static void ru_ep0_setup_hw(void)
+{
+	uint32_t csr = ru_rd(ru.mac, RU_EP0CSR);
+	csr &= ~RU_EP0_MAXPKTSZ_MASK;
+	csr |= 64u;
+	csr &= RU_EP0_W1C_BITS;
+	ru_wr(ru.mac, RU_EP0CSR, csr);
+	ru_wr(ru.mac, RU_EPIESR, RU_EP0ISR | RU_SETUPENDISR);
+}
+
 static void ru_controller_init(void)
 {
 	uint32_t tmp, csr;
@@ -731,7 +798,7 @@
 	tmp = ru_rd(ru.mac, RU_POWER_MGMT) | RU_MAC_HS_ENABLE | RU_MAC_SUSPENDM_ENABLE | RU_MAC_LPM_HRWE;
 	tmp &= ~RU_MAC_SOFT_CONN;
 	ru_wr(ru.mac, RU_POWER_MGMT, tmp);
-	ru_wr(ru.mac, 0x0800u, 0);
+	ru_wr(ru.mac, RU_DEVICE_CONF, 0);
 	ru_wr(ru.mac, RU_LINK_RESET, ru_rd(ru.mac, RU_LINK_RESET) & ~(0x0fu << 16));
 	ru_wr(ru.mac, RU_USB2_EPCTL_LPM, 1u);
 	ru_wr(ru.mac, RU_USB2_EPCTL_LPM_FC, 0u);
@@ -739,9 +806,13 @@
 	csr &= ~(RU_EP0_MAXPKTSZ_MASK | RU_EP0_RXPKTRDY | RU_EP0_SETUPPKTRDY | RU_EP0_SENTSTALL);
 	ru_wr(ru.mac, RU_EP0CSR, csr | 64u);
 	ru_wr(ru.mac, RU_EPISR, 0xffffffffu);

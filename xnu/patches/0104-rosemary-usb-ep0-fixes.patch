+ * U3D_DEVICE_CONF (0x0800, bits 30:24), NOT in U3D_DEVICE_CONTROL (0x240c). */
+#define RU_DEVICE_CONF           0x0800u
+#define RU_EPIESR                0x0088u
+#define RU_DEV_LINK_INTR_EN      0x0850u
+#define RU_DEV_LINK_INTR         0x0854u
+#define RU_USB2_LPM_PARAM        0x2444u
+#define RU_USB2_COMMON_INTR_EN   0x2418u

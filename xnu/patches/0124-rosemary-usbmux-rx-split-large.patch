+/* 0124: usbmuxd sends whatever its client wrote as ONE mux frame, up to
+ * USB_MTU (49152 bytes). A 20 KB `cat > file` over ssh arrived as a single
+ * 20254-byte frame, ru_mbuf_alloc_contig() (16 KB cluster limit) refused it
+ * ("failed to allocate TCP input mbuf len=20254"), the data vanished and the
+ * transfer hung. Inject such a segment into XNU as several MSS-sized TCP
+ * segments with consecutive sequence numbers. FIN/PSH go on the last piece
+ * only; everything else (ack, window, ports) is shared. */
+#define RU_MUX_RX_SEG 1400u
+static int ru_mux_tcp_input(const uint8_t *segment, uint32_t tcp_len)
+{
+	uint8_t buf[60u + RU_MUX_RX_SEG];
+	size_t hl;
+	uint32_t payload, off = 0u, seq;
+	if (!segment || tcp_len < sizeof(struct tcphdr)) return 0;
+	hl = (size_t)((segment[12] >> 4) & 0x0fu) * 4u;
+	if (hl < sizeof(struct tcphdr) || hl > 60u || hl > tcp_len) {
+		return ru_mux_tcp_input_one(segment, tcp_len); /* reports the bad header */
+	}
+	payload = tcp_len - (uint32_t)hl;
+	if (payload <= RU_MUX_RX_SEG) return ru_mux_tcp_input_one(segment, tcp_len);
+	printf("ROSEMARY USB: TCP IN large segment payload=%u, injecting in %u-byte pieces\n",
+	    payload, RU_MUX_RX_SEG);
+	seq = ((uint32_t)segment[4] << 24) | ((uint32_t)segment[5] << 16) |
+	    ((uint32_t)segment[6] << 8) | segment[7];
+	while (off < payload) {
+		uint32_t n = payload - off;
+		uint32_t s2 = seq + off;
+		if (n > RU_MUX_RX_SEG) n = RU_MUX_RX_SEG;
+		bcopy(segment, buf, hl);
+		buf[4] = (uint8_t)(s2 >> 24);
+		buf[5] = (uint8_t)(s2 >> 16);
+		buf[6] = (uint8_t)(s2 >> 8);
+		buf[7] = (uint8_t)s2;
+		buf[16] = 0;
+		buf[17] = 0;
+		if (off + n < payload) buf[13] &= (uint8_t)~(TH_FIN | 0x08u /* PSH */);
+		bcopy(segment + hl + off, buf + hl, n);
+		(void)ru_mux_tcp_input_one(buf, (uint32_t)hl + n);
+		off += n;
+	}
+	return 1;
+}

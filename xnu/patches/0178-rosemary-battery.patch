index 0000000..d0d9dd0
--- /dev/null
+++ b/bsd/dev/rosemary_battery.c
@@ -0,0 +1,486 @@
+/*
+ * ROSEMARY battery: the state of the charger, and the voltage of the cell.
+ *
+ * The phone has a MediaTek MT6360 sub-PMIC on I2C5 (GPIO28 = SCL, GPIO29 = SDA; the same bus
+ * and the same bit-banged access the touch driver uses to power its panel): the PMU block
+ * at 0x34 has the charger and a 16-bit ADC. The registers are those of the Linux
+ * drivers mt6360_charger.c and mt6360-adc.c (the low byte of their 0x3xx addresses):
+ *   0x4a CHG_STAT   bits 7:6  0 ready, 1 charging, 2 done, 3 fault
+ *   0xe7 FOD_STAT   bit 4     the supply is there (CHRDET_EXT)
+ *   0x27 USB_STATUS1 bits 6:4 what is plugged in
+ *   0x56/0x57 ADC_CONFIG (16 bit, big endian): bit 15 enables the ADC, bit N picks the channel
+ *   0x5a ADC_RPT_1  bits 7:4 preferred channel, bits 3:0 the channel the result is of
+ *   0x5b/0x5c       the result (16 bit, big endian); channel 4 is VBAT, 1.25 mV per step
+ * The ADC is switched on for one reading and off again; it needs 25..75 ms to settle.
+ *
+ * Reads are plain I2C. A write is tried without the PEC byte first and read back; only if it
+ * did not take it is repeated with PEC (CRC-8, poly 7, over addr_w + reg + data), because on
+ * a chip without PEC the extra byte would land in the next register.
+ *
+ * Nothing else is written, and nothing is written unless the chip answers on 0x34.
+ *
+ * Boot-args: rosebatt=0 off; rosebattdelay=<s> start delay (default 25); rosebattsec=<s> poll
+ * period (default 10); rosebattlsb=<uV per step> (default 1250); rosebattlog=1 log every sample.
+ * Log lines start with "ROSEMARY BATT:".
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET) && defined(ROSEMARY)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+int rosemary_battery_start(void);
+int rosemary_battery_get(unsigned *mv, unsigned *flags);
+
+#define GPIO_PA         0x10005000u
+#define BUS5_SCL        28u
+#define BUS5_SDA        29u
+#define MT6360_PMU      0x34u
+#define HALF_US         3u
+
+#define R_CRCEN         0x03u
+#define R_USB_STATUS1   0x27u
+#define R_CHG_STAT      0x4au
+#define R_ADC_CONFIG    0x56u
+#define R_ADC_RPT1      0x5au
+#define R_FOD_STAT      0xe7u
+#define CH_VBAT         4u
+#define CH_NONE         15u
+
+/* what rosemary_battery_get() hands out */
+#define BATT_EXTERNAL   0x1u
+#define BATT_CHARGING   0x2u
+#define BATT_FULL       0x4u
+#define BATT_FAULT      0x8u
+
+static vm_offset_t gpio;
+static int batt_chan;
+static volatile uint32_t st_valid, st_mv, st_flags;
+static int pec_needed = -1;                     /* -1 not known yet */
+
+static uint32_t
+grd(uint32_t off)
+{
+	return *(volatile uint32_t *)(gpio + off);
+}
+
+static void
+gwr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(gpio + off) = v;
+}
+
+static void
+gpio_set_mode(unsigned n, unsigned mode)
+{
+	uint32_t base = 0x300u + 0x10u * (n / 8);
+	unsigned sh = 4 * (n % 8);
+
+	gwr(base + 8, 7u << sh);
+	gwr(base + 4, (mode & 7u) << sh);
+}
+
+static void
+gpio_out(unsigned n, unsigned level)
+{
+	uint32_t m = 1u << (n % 32);
+
+	gwr(0x000u + 0x10u * (n / 32) + 4, m);
+	gwr(0x100u + 0x10u * (n / 32) + (level ? 4 : 8), m);
+}
+
+static void
+gpio_in(unsigned n)
+{
+	gwr(0x000u + 0x10u * (n / 32) + 8, 1u << (n % 32));
+}
+
+static unsigned
+gpio_din(unsigned n)
+{
+	return (grd(0x200u + 0x10u * (n / 32)) >> (n % 32)) & 1u;
+}
+
+static void
+sleep_ms(uint32_t ms)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&batt_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* ---- bit-banged I2C on GPIO28/29 (open drain by direction), as in rosemary_touch.c ---- */
+static void scl_lo(void) { gpio_out(BUS5_SCL, 0); }
+static void sda_lo(void) { gpio_out(BUS5_SDA, 0); }
+static void sda_hi(void) { gpio_in(BUS5_SDA); }
+
+static void
+scl_hi(void)
+{
+	gpio_in(BUS5_SCL);
+	for (int i = 0; i < 500 && !gpio_din(BUS5_SCL); i++) {
+		delay(1);
+	}
+}
+
+static void
+i2c_start(void)
+{
+	sda_hi();
+	scl_hi();
+	delay(HALF_US);
+	sda_lo();
+	delay(HALF_US);
+	scl_lo();
+}
+
+static void
+i2c_stop(void)
+{
+	sda_lo();
+	delay(HALF_US);
+	scl_hi();
+	delay(HALF_US);
+	sda_hi();
+	delay(HALF_US);
+}
+
+static int
+i2c_wr(uint8_t b)
+{
+	for (int i = 7; i >= 0; i--) {
+		if ((b >> i) & 1) {
+			sda_hi();
+		} else {
+			sda_lo();
+		}
+		delay(HALF_US);
+		scl_hi();
+		delay(HALF_US);
+		scl_lo();
+	}
+	sda_hi();
+	delay(HALF_US);
+	scl_hi();
+	delay(HALF_US);
+	int ack = !gpio_din(BUS5_SDA);
+	scl_lo();
+	return ack;
+}
+
+static uint8_t
+i2c_rd(int ack)
+{
+	uint8_t v = 0;
+
+	sda_hi();
+	for (int i = 0; i < 8; i++) {
+		delay(HALF_US);
+		scl_hi();
+		delay(HALF_US);
+		v = (uint8_t)((v << 1) | gpio_din(BUS5_SDA));
+		scl_lo();
+	}
+	if (ack) {
+		sda_lo();
+	} else {
+		sda_hi();
+	}
+	delay(HALF_US);
+	scl_hi();
+	delay(HALF_US);
+	scl_lo();
+	sda_hi();
+	return v;
+}
+
+/* write the register, repeated start, read n bytes. 0 = ok */
+static int
+i2c_read(uint8_t addr, uint8_t reg, uint8_t *out, int n)
+{
+	i2c_start();
+	if (!i2c_wr((uint8_t)(addr << 1))) {
+		i2c_stop();
+		return -1;
+	}
+	if (!i2c_wr(reg)) {
+		i2c_stop();
+		return -2;
+	}
+	i2c_start();
+	if (!i2c_wr((uint8_t)(addr << 1 | 1))) {
+		i2c_stop();
+		return -3;
+	}
+	for (int i = 0; i < n; i++) {
+		out[i] = i2c_rd(i < n - 1);
+	}
+	i2c_stop();
+	return 0;
+}
+
+static uint8_t
+crc8(const uint8_t *d, int n)
+{
+	uint8_t c = 0;
+
+	while (n--) {
+		c ^= *d++;
+		for (int i = 0; i < 8; i++) {
+			c = (uint8_t)((c & 0x80) ? (c << 1) ^ 0x07 : c << 1);
+		}
+	}
+	return c;
+}
+
+/* reg and the n bytes after it; with a PEC byte at the end when `pec`. 0 = all acknowledged */
+static int
+i2c_write(uint8_t reg, const uint8_t *data, int n, int pec)
+{
+	uint8_t m[8];
+	int ok;
+
+	if (n > 4) {
+		return -1;
+	}
+	m[0] = (uint8_t)(MT6360_PMU << 1);
+	m[1] = reg;
+	for (int i = 0; i < n; i++) {
+		m[2 + i] = data[i];
+	}
+	i2c_start();
+	ok = i2c_wr(m[0]) && i2c_wr(m[1]);
+	for (int i = 0; ok && i < n; i++) {
+		ok = i2c_wr(m[2 + i]);
+	}
+	if (ok && pec) {
+		ok = i2c_wr(crc8(m, 2 + n));
+	}
+	i2c_stop();
+	return ok ? 0 : -2;
+}
+
+static int
+rd(uint8_t reg, uint8_t *v)
+{
+	return i2c_read(MT6360_PMU, reg, v, 1);
+}
+
+static void
+bus_claim(void)
+{
+	gpio_set_mode(BUS5_SCL, 0);
+	gpio_set_mode(BUS5_SDA, 0);
+	sda_hi();
+	gpio_in(BUS5_SCL);
+	delay(1000);
+}
+
+static void
+bus_release(void)
+{
+	gpio_in(BUS5_SCL);
+	gpio_in(BUS5_SDA);
+}
+
+/* A write that is read back: first without PEC, then with it. `mask` is what is compared. 0 = taken. */
+static int
+write_checked(uint8_t reg, const uint8_t *data, int n, uint8_t mask0)
+{
+	for (int attempt = 0; attempt < 2; attempt++) {
+		int pec = pec_needed >= 0 ? pec_needed : attempt;
+		uint8_t back[4] = { 0 };
+		int same = 1;
+
+		(void)i2c_write(reg, data, n, pec);
+		delay(500);
+		if (i2c_read(MT6360_PMU, reg, back, n)) {
+			return -1;
+		}
+		for (int i = 0; i < n; i++) {
+			uint8_t m = i == 0 ? mask0 : 0xff;
+
+			if ((back[i] & m) != (data[i] & m)) {
+				same = 0;
+			}
+		}
+		if (same) {
+			if (pec_needed < 0) {
+				pec_needed = pec;
+				printf("ROSEMARY BATT: writes to 0x34 %s PEC\n", pec ? "need" : "do not need");
+			}
+			return 0;
+		}
+		if (pec_needed >= 0) {
+			break;
+		}
+	}
+	return -2;
+}
+
+/* one conversion of a channel of the ADC: raw 16-bit result, or -1 */
+static int
+adc_read(unsigned channel)
+{
+	uint8_t rpt[3] = { 0 }, cfg[2], pre;
+	int raw = -1;
+
+	if (rd(R_ADC_RPT1, &pre)) {
+		return -1;
+	}
+	pre = (uint8_t)((pre & 0x0f) | (channel << 4));
+	if (write_checked(R_ADC_RPT1, &pre, 1, 0xf0)) {
+		return -1;
+	}
+	cfg[0] = (uint8_t)((0x8000u | (1u << channel)) >> 8);
+	cfg[1] = (uint8_t)(1u << channel);
+	if (write_checked(R_ADC_CONFIG, cfg, 2, 0xff)) {
+		return -1;
+	}
+	sleep_ms(80);
+	for (int t = 0; t < 50; t++) {
+		if (i2c_read(MT6360_PMU, R_ADC_RPT1, rpt, 3) == 0 && (rpt[0] & 0x0f) == channel) {
+			raw = (rpt[1] << 8) | rpt[2];
+			break;
+		}
+		sleep_ms(2);
+	}
+	cfg[1] = 0;
+	(void)write_checked(R_ADC_CONFIG, cfg, 2, 0xff);
+	pre = (uint8_t)((rpt[0] & 0x0f) | (CH_NONE << 4));
+	(void)write_checked(R_ADC_RPT1, &pre, 1, 0xf0);
+	return raw;
+}
+
+static void
+dump_once(void)
+{
+	static const uint8_t regs[] = {
+		0x00, 0x01, 0x02, 0x03, 0x11, 0x12, 0x13, 0x14, 0x27, 0x4a, 0x52, 0x53, 0x56, 0x57,
+		0x58, 0x5a, 0x5b, 0x5c, 0xe0, 0xe1, 0xe2, 0xe3, 0xe4, 0xe5, 0xe6, 0xe7
+	};
+	char line[160];
+	int len = 0;
+
+	for (unsigned i = 0; i < sizeof(regs); i++) {
+		uint8_t v = 0;
+		int e = rd(regs[i], &v);
+
+		len += snprintf(line + len, sizeof(line) - (size_t)len, " %02x=%s%02x", regs[i], e ? "?" : "", v);
+		if (len > 110 || i == sizeof(regs) - 1) {
+			printf("ROSEMARY BATT: 0x34:%s\n", line);
+			len = 0;
+		}
+	}
+}
+
+static void
+battery_thread(void *arg, wait_result_t result)
+{
+	int delay_s = 25, period_s = 10, lsb = 1250, logall = 0, samples = 0;
+	unsigned last_mv = 0, last_flags = ~0u;
+	uint8_t id = 0;
+
+	(void)PE_parse_boot_argn("rosebattdelay", &delay_s, sizeof(delay_s));
+	(void)PE_parse_boot_argn("rosebattsec", &period_s, sizeof(period_s));
+	(void)PE_parse_boot_argn("rosebattlsb", &lsb, sizeof(lsb));
+	(void)PE_parse_boot_argn("rosebattlog", &logall, sizeof(logall));
+	sleep_ms((uint32_t)delay_s * 1000u);
+	gpio = ml_io_map(GPIO_PA, 0x1000);
+	if (!gpio) {
+		printf("ROSEMARY BATT: GPIO mapping failed\n");
+		return;
+	}
+	bus_claim();
+	if (rd(0x00, &id)) {
+		bus_release();
+		printf("ROSEMARY BATT: MT6360 at 0x34 does not answer, no battery data\n");
+		return;
+	}
+	printf("ROSEMARY BATT: MT6360 answers, reg 0 = %#x\n", id);
+	dump_once();
+	bus_release();
+	for (;;) {
+		uint8_t chg = 0, fod = 0, usb = 0;
+		int raw;
+		unsigned mv, flags = 0;
+
+		bus_claim();
+		if (rd(R_CHG_STAT, &chg) || rd(R_FOD_STAT, &fod) || rd(R_USB_STATUS1, &usb)) {
+			bus_release();
+			st_valid = 0;
+			sleep_ms((uint32_t)period_s * 1000u);
+			continue;
+		}
+		raw = adc_read(CH_VBAT);
+		bus_release();
+		mv = raw > 0 ? (unsigned)((uint64_t)raw * (uint64_t)lsb / 1000u) : 0;
+		if (fod & 0x10) {
+			flags |= BATT_EXTERNAL;
+			switch ((chg >> 6) & 3) {
+			case 1:
+				flags |= BATT_CHARGING;
+				break;
+			case 2:
+				flags |= BATT_FULL;
+				break;
+			case 3:
+				flags |= BATT_FAULT;
+				break;
+			}
+		}
+		st_mv = mv;
+		st_flags = flags;
+		st_valid = mv != 0;
+		if (logall || samples < 3 || flags != last_flags || (mv > last_mv + 50 || mv + 50 < last_mv)) {
+			printf("ROSEMARY BATT: chg_stat %#x fod_stat %#x usb_status %#x vbat raw %d = %u mV flags %#x\n",
+			    chg, fod, usb, raw, mv, flags);
+			last_mv = mv;
+			last_flags = flags;
+		}
+		samples++;
+		sleep_ms((uint32_t)period_s * 1000u);
+	}
+}
+
+/* what the last reading was: 0 = good. The voltage in mV, the flags as BATT_*. */
+int
+rosemary_battery_get(unsigned *mv, unsigned *flags)
+{
+	if (!st_valid) {
+		return -1;
+	}
+	*mv = st_mv;
+	*flags = st_flags;
+	return 0;
+}
+
+/* once, from the battery service */
+int
+rosemary_battery_start(void)
+{
+	static int started;
+	int on = 1;
+	thread_t thread;
+
+	(void)PE_parse_boot_argn("rosebatt", &on, sizeof(on));
+	if (!on) {
+		printf("ROSEMARY BATT: disabled (rosebatt=0)\n");
+		return -1;
+	}
+	if (!started) {
+		started = 1;
+		if (kernel_thread_start(battery_thread, NULL, &thread) != KERN_SUCCESS) {
+			return -1;
+		}
+		thread_deallocate(thread);
+	}
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET && ROSEMARY */
